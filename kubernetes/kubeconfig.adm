// Kubeconfig files as kubectl reads them, merged, and the Config of one
// context; the service account of a pod.
internal partial module adm.dev.kubernetes.api {
	use (
		std.data.encoding::(YAML, yaml, base64decode)
		std.os
		std.services.runtime::(Runtime)
		adm.dev.kubernetes::*
	)

	// What separates the files of `KUBECONFIG`.
	@os("linux", "darwin", "android", "ios", "wasm")
	const listSeparator = ":"
	@os("windows")
	const listSeparator = ";"

	// Where a pod's service account is mounted.
	const serviceAccountDir = "/var/run/secrets/kubernetes.io/serviceaccount"

	// Surroundings is what the client reads about the machine: the
	// environment, the home folder, files, and the credential plugins it
	// runs. Tests hand in their own.
	struct Surroundings {
		// A variable of the environment; none when it is not set.
		env       def (string) ?string
		home      string
		// A file's bytes; fails when it cannot be read.
		readFile  def (string) !byte[]
		// Whether a path exists.
		exists    def (string) bool
		// Runs a credential plugin with its arguments, extra environment
		// and standard input, and returns its output and exit code.
		runPlugin def (string, string[], map<string, string>) !(string, int)
	}

	// The surroundings of a real program.
	def realSurroundings() Surroundings {
		let home = os.homeDir() onerror recover ""
		return Surroundings{env: def (name string) ?string {
			return Runtime.getEnv(name)
		}, home: home, readFile: def (path string) !byte[] {
			return try os.readFile(path)
		}, exists: def (path string) bool {
			return os.exists(path) onerror recover false
		}, runPlugin: def (program string, args string[], env map<string, string>) !(string, int) {
			return try runProgram(program, args, env)
		}}
	}

	// The value under a key; "" when there is none.
	def textAt(values map<string, string>, key string) string {
		let found = values.get(key)
		return found is none ?? ("", found)
	}

	def envOf(from Surroundings, name string) string {
		let read = from.env
		let value = read(name)
		return value is none ?? ("", value)
	}

	// Runs a program without a shell, its standard input closed, and
	// returns its output and exit code; its standard error is this
	// program's, where a plugin's prompts and messages go.
	def runProgram(program string, args string[], env map<string, string>) !(string, int) {
		let process = try Runtime.start(program, args, env)
		process.input.close() onerror recover none
		let out byte[] = []
		let chunk byte[] = []
		chunk.len(4096)
		for {
			let got = process.output.read(chunk) onerror recover 0
			break when got <= 0
			out.push(...chunk[0:got])
		}
		let code = try process.wait()
		return (string(out), code)
	}

	// The files of a kubeconfig, as YAML (or JSON) has them.
	struct KubeconfigFile {
		@yaml("current-context")
		currentContext string = ""
		clusters NamedClusterWire[] = []
		users NamedUserWire[] = []
		contexts NamedContextWire[] = []
	}

	struct NamedClusterWire {
		name    string      = ""
		cluster ClusterWire = ClusterWire{}
	}

	struct ClusterWire {
		server string = ""
		@yaml("certificate-authority")
		certificateAuthority string = ""
		@yaml("certificate-authority-data")
		certificateAuthorityData string = ""
		@yaml("insecure-skip-tls-verify")
		insecureSkipTlsVerify bool = false
		@yaml("tls-server-name")
		tlsServerName string = ""
		@yaml("proxy-url")
		proxyUrl string = ""
		extensions NamedExtension[] = []
	}

	struct NamedExtension {
		name      string = ""
		extension any
	}

	struct NamedUserWire {
		name string   = ""
		user UserWire = UserWire{}
	}

	struct UserWire {
		@yaml("client-certificate")
		clientCertificate string = ""
		@yaml("client-certificate-data")
		clientCertificateData string = ""
		@yaml("client-key")
		clientKey string = ""
		@yaml("client-key-data")
		clientKeyData string = ""
		token string = ""
		tokenFile string = ""
		@yaml("as")
		impersonate string = ""
		@yaml("as-uid")
		impersonateUid string = ""
		@yaml("as-groups")
		impersonateGroups string[] = []
		@yaml("as-user-extra")
		impersonateExtra map<string, string[]> = {}
		username string = ""
		password string = ""
		@yaml("auth-provider")
		authProvider ?AuthProviderWire = none
		exec ?ExecWire = none
	}

	struct AuthProviderWire {
		name   string              = ""
		config map<string, string> = {}
	}

	struct ExecWire {
		command            string        = ""
		args               string[]      = []
		env                ExecEnvWire[] = []
		apiVersion         string        = ""
		installHint        string        = ""
		provideClusterInfo bool          = false
		interactiveMode    string        = ""
	}

	struct ExecEnvWire {
		name  string = ""
		value string = ""
	}

	struct NamedContextWire {
		name    string      = ""
		context ContextWire = ContextWire{}
	}

	struct ContextWire {
		cluster   string = ""
		user      string = ""
		namespace string = ""
	}

	// The entries of several files, the first of each name kept, with the
	// folder of the file each came from (relative paths in it are taken
	// from there).
	struct MergedKubeconfig {
		currentContext string              = ""
		clusters       NamedClusterWire[]  = []
		clusterDirs    map<string, string> = {}
		users          NamedUserWire[]     = []
		userDirs       map<string, string> = {}
		contexts       NamedContextWire[]  = []
	}

	def decodeKubeconfig(text string, about string) !KubeconfigFile {
		let out = KubeconfigFile{}
		new YAML().decode(text, out) onerror (err error) {
			fail errorOf(ErrorKind.Argument, "kubernetes: {about} does not read as a kubeconfig: {err.message}", cause = err)
		}
		return out
	}

	def mergeInto(merged MergedKubeconfig, file KubeconfigFile, dir string) {
		merged.currentContext = file.currentContext when merged.currentContext == ""
		for let entry in file.clusters {
			continue when merged.clusterDirs.hasKey(entry.name)
			merged.clusters.push(entry)
			merged.clusterDirs[entry.name] = dir
		}
		for let entry in file.users {
			continue when merged.userDirs.hasKey(entry.name)
			merged.users.push(entry)
			merged.userDirs[entry.name] = dir
		}
		for let entry in file.contexts {
			let taken = false
			for let known in merged.contexts {
				taken = true when known.name == entry.name
			}
			merged.contexts.push(entry) unless taken
		}
	}

	// A file a kubeconfig names, taken from the folder of the file that
	// named it when relative.
	def resolvePath(path string, dir string) string {
		return path when path == "" || dir == ""
		return os.absolute(path, dir)
	}

	// The text of an inline `-data` value (base64), else of the file named.
	def pemOf(data string, path string, dir string, about string, from Surroundings) !string {
		if data != "" {
			let decoded = base64decode(data.trim()) onerror (err error) {
				fail errorOf(ErrorKind.Argument, "kubernetes: {about} is not base64: {err.message}", cause = err)
			}
			return string(decoded)
		}
		return "" when path == ""
		let full = resolvePath(path, dir)
		let load = from.readFile
		let read = load(full) onerror (err error) {
			fail errorOf(ErrorKind.Argument, "kubernetes: cannot read {about} {full}: {err.message}", cause = err)
		}
		return string(read)
	}

	// The Config of one context of merged files.
	def configOf(merged MergedKubeconfig, name string, from Surroundings) !Config {
		fail errorOf(ErrorKind.Argument, "kubernetes: the kubeconfig names no current context; name one") when name == ""
		let context ?ContextWire = none
		for let entry in merged.contexts {
			context = entry.context when entry.name == name && context is none
		}
		fail errorOf(ErrorKind.Argument, "kubernetes: the kubeconfig has no context {name}") when context is none
		let cluster ?ClusterWire = none
		for let entry in merged.clusters {
			cluster = entry.cluster when entry.name == context.cluster && cluster is none
		}
		fail errorOf(ErrorKind.Argument, "kubernetes: context {name} names cluster {context.cluster}, which the kubeconfig does not have") when cluster is none
		let out = Config{}
		let clusterDir = textAt(merged.clusterDirs, context.cluster)
		out.server = cluster.server
		fail errorOf(ErrorKind.Argument, "kubernetes: cluster {context.cluster} has no server") when out.server == ""
		out.certificateAuthority = try pemOf(cluster.certificateAuthorityData, cluster.certificateAuthority, clusterDir, "the certificate authority of cluster {context.cluster}", from)
		out.insecureSkipVerify = cluster.insecureSkipTlsVerify
		out.serverName = cluster.tlsServerName
		out.proxy = cluster.proxyUrl
		out.namespace = context.namespace unless context.namespace == ""
		if context.user != "" {
			let user ?UserWire = none
			for let entry in merged.users {
				user = entry.user when entry.name == context.user && user is none
			}
			fail errorOf(ErrorKind.Argument, "kubernetes: context {name} names user {context.user}, which the kubeconfig does not have") when user is none
			let userDir = textAt(merged.userDirs, context.user)
			try applyUser(out, user, userDir, context.user, cluster, from)
		}
		return out
	}

	def applyUser(out Config, user UserWire, dir string, name string, cluster ClusterWire, from Surroundings) !none {
		out.clientCertificate = try pemOf(user.clientCertificateData, user.clientCertificate, dir, "the client certificate of user {name}", from)
		let key = try pemOf(user.clientKeyData, user.clientKey, dir, "the client key of user {name}", from)
		out.clientKey = new Secret<string>(key) unless key == ""
		out.token = new Secret<string>(user.token) unless user.token == ""
		out.tokenFile = resolvePath(user.tokenFile, dir)
		out.username = user.username
		out.password = new Secret<string>(user.password) unless user.password == ""
		let provider = user.authProvider
		out.authProvider = AuthProvider{name: provider.name, config: provider.config} unless provider is none
		let wire = user.exec
		if !(wire is none) {
			let program = ExecPlugin{command: resolveCommand(wire.command, dir), args: wire.args, apiVersion: wire.apiVersion, installHint: wire.installHint, provideClusterInfo: wire.provideClusterInfo}
			program.interactiveMode = wire.interactiveMode unless wire.interactiveMode == ""
			for let variable in wire.env {
				program.env[variable.name] = variable.value
			}
			for let extension in cluster.extensions {
				program.clusterConfig = extension.extension when extension.name == "client.authentication.k8s.io/exec"
			}
			out.exec = program
		}
		let impersonating = user.impersonate != "" || user.impersonateUid != "" || user.impersonateGroups.len() > 0 || user.impersonateExtra.len() > 0
		out.impersonate = Impersonation{user: user.impersonate, uid: user.impersonateUid, groups: user.impersonateGroups, extra: user.impersonateExtra} when impersonating
		return none
	}

	// A plugin command with a path separator is taken from the
	// kubeconfig's folder when relative; a bare name is looked up in
	// `PATH`.
	def resolveCommand(command string, dir string) string {
		return command unless command.contains("/") || command.contains("\\")
		return resolvePath(command, dir)
	}

	// The Config of the pod the program runs in.
	def inClusterConfig(from Surroundings) !Config {
		let host = envOf(from, "KUBERNETES_SERVICE_HOST")
		let port = envOf(from, "KUBERNETES_SERVICE_PORT")
		fail errorOf(ErrorKind.Argument, "kubernetes: not in a cluster: KUBERNETES_SERVICE_HOST and KUBERNETES_SERVICE_PORT are not set") when host == "" || port == ""
		let tokenPath = os.join(serviceAccountDir, "token")
		let present = from.exists
		fail errorOf(ErrorKind.Argument, "kubernetes: not in a cluster: no service account token at {tokenPath}") unless present(tokenPath)
		let out = Config{}
		out.server = host.contains(":") ?? ("https://[{host}]:{port}", "https://{host}:{port}")
		out.tokenFile = tokenPath
		let load = from.readFile
		let ca = load(os.join(serviceAccountDir, "ca.crt")) onerror (err error) {
			fail errorOf(ErrorKind.Argument, "kubernetes: cannot read the service account's CA: {err.message}", cause = err)
		}
		out.certificateAuthority = string(ca)
		let namespace = load(os.join(serviceAccountDir, "namespace")) onerror recover byte[]
		let name = string(namespace).trim()
		out.namespace = name unless name == ""
		return out
	}
}
