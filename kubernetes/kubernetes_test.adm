// These tests need a cluster; without ADM_TEST_KUBECONFIG they pass
// without running. Each makes a namespace named `adm-test-*`, which it
// deletes again, and works inside it.
partial module adm.dev.kubernetes {
	use (
		std.crypto
		std.net
		std.net.tcp
		std.testing
		std.time
		adm.dev.kubernetes.api::*
	)

	// The kubeconfig of the cluster to test against; its current context
	// is used.
	@env("ADM_TEST_KUBECONFIG")
	internal const testKubeconfig string

	// A name no other run uses.
	internal def testName(what string) string {
		let suffix = (crypto.rand(4) onerror recover byte[1, 2, 3, 4]).hex().lower()
		return "adm-test-{what}-{suffix}"
	}

	// The cluster and a namespace made for the test.
	internal def testCluster() !(Cluster, string) {
		let cluster = try connect(kubeconfig = testKubeconfig)
		let made = new Namespace()
		made.name = testName("ns")
		try cluster.namespaces().create(made)
		return (cluster, made.name)
	}

	internal def dropNamespace(cluster Cluster, name string) {
		cluster.namespaces().delete(name) onerror recover none
	}

	internal def failureOf(err error) ErrorKind {
		return err.kind when err is KubernetesError
		return ErrorKind.Server
	}

	check "Cluster" {
		@test()
		def TestDiscovery() !none {
			return none when testKubeconfig == ""
			let cluster = try connect(kubeconfig = testKubeconfig)
			let version = try cluster.version()
			assert version.gitVersion.startsWith("v1.")
			let groups = try cluster.groups()
			assert groups[0].name == ""
			let apps = groups.filter(g => g.name == "apps")
			assert apps.len() == 1
			let served = try cluster.resources("apps/v1")
			assert served.filter(r => r.name == "deployments/scale").len() == 1
			let kind = try cluster.kind("apps/v1", "Deployment")
			assert kind.plural == "deployments" && kind.namespaced
			let schema = try cluster.schema("apps/v1", "Deployment")
			assert schema.hasKey("properties")
			return none
		}

		@test()
		def TestWrites() !none {
			return none when testKubeconfig == ""
			let (cluster, namespace) = try testCluster()
			defer dropNamespace(cluster, namespace)
			let maps = cluster.configMaps(namespace)
			let made = new ConfigMap()
			made.name = "settings"
			made.metadata.labels = {"app": "web"}
			made.data = {"mode": "fast"}
			let stored = try maps.create(made)
			assert stored.metadata.uid != "" && stored.metadata.resourceVersion != ""
			let again = maps.create(made) onerror (err error) {
				assert failureOf(err) == ErrorKind.AlreadyExists
				recover new ConfigMap()
			}
			assert again.name == ""
			let read = try maps.get("settings")
			assert read.data["mode"] == "fast"
			read.data["mode"] = "slow"
			let updated = try maps.update(read)
			assert updated.data["mode"] == "slow"
			// The version read before the update is stale now.
			stored.data["mode"] = "stale"
			let stale = maps.update(stored) onerror (err error) {
				assert failureOf(err) == ErrorKind.Conflict
				recover new ConfigMap()
			}
			assert stale.name == ""
			let merged = try maps.patch("settings", {"data": {"extra": "1"}})
			assert merged.data["extra"] == "1" && merged.data["mode"] == "slow"
			let operations = try maps.patch("settings", "[\{\"op\": \"remove\", \"path\": \"/data/extra\"\}]", PatchKind.Json)
			assert !operations.data.hasKey("extra")
			let applied = new ConfigMap()
			applied.name = "settings"
			applied.data = {"owned": "yes"}
			let after = try maps.apply(applied, fieldManager = "adm-test")
			assert after.data["owned"] == "yes"
			let listed = try maps.list(labels = "app=web")
			assert listed.len() == 1 && listed[0].name == "settings"
			let missing = try maps.find("nothing")
			assert missing is none
			try maps.delete("settings")
			let gone = maps.get("settings") onerror (err error) {
				assert failureOf(err) == ErrorKind.NotFound
				recover new ConfigMap()
			}
			assert gone.name == ""
			return none
		}

		@test()
		def TestWatch() !none {
			return none when testKubeconfig == ""
			let (cluster, namespace) = try testCluster()
			defer dropNamespace(cluster, namespace)
			let maps = cluster.configMaps(namespace)
			let start = try maps.page()
			// A new namespace gets the `kube-root-ca.crt` map too.
			let watch = try maps.watch(fields = "metadata.name=watched", resourceVersion = start.metadata.resourceVersion)
			defer watch.close()
			let made = new ConfigMap()
			made.name = "watched"
			try maps.create(made)
			try maps.patch("watched", {"data": {"a": "b"}})
			try maps.delete("watched")
			let seen EventKind[] = []
			for let event in watch {
				assert event.object.name == "watched"
				seen.push(event.kind)
				break when seen.len() == 3
			}
			assert seen.len() == 3 && seen[0] == EventKind.Added && seen[1] == EventKind.Modified && seen[2] == EventKind.Deleted
			return none
		}

		@test()
		def TestPods() !none {
			return none when testKubeconfig == ""
			let (cluster, namespace) = try testCluster()
			defer dropNamespace(cluster, namespace)
			let pods = cluster.pods(namespace)
			let pod = try runningPod(pods, "web", "echo hello; mkdir -p /tmp/www; echo served > /tmp/www/index.html; httpd -f -p 8080 -h /tmp/www")
			assert pod.status.phase == "Running"
			let log = try waitForLog(pods, "web", "hello")
			assert log.contains("hello")
			let result = try pods.run("web", ["sh", "-c", "echo out; echo err >&2; exit 3"])
			assert result.stdout == "out\n" && result.stderr == "err\n" && result.exitCode == 3
			let echoed = try pods.run("web", ["cat"], input = "abc")
			assert echoed.stdout == "abc" && echoed.exitCode == 0
			let terminal = try pods.exec("web", ["sh", "-c", "echo hi"], tty = true)
			try terminal.resize(100, 30)
			let printed = string(try terminal.stdout.readAll())
			assert printed.contains("hi") && try terminal.wait() == 0
			terminal.close()
			let missing = pods.run("web", ["no-such-program"]) onerror (err error) {
				recover ExecResult{stdout: "", stderr: "", exitCode: -1}
			}
			assert missing.exitCode != 0
			let forward = try pods.portForward("web")
			defer forward.close()
			let stream = try forward.dial(8080)
			try stream.write("GET /index.html HTTP/1.0\r\n\r\n".bytes())
			let answer = string(try readStream(stream))
			assert answer.contains("200") && answer.contains("served")
			let local = try forward.listen(8080)
			defer local.close()
			let client = new tcp.Client()
			try client.connect("127.0.0.1:{local.localPort}")
			try net.writeAll(client, "GET /index.html HTTP/1.0\r\n\r\n".bytes())
			let viaLocal = string(try readStream(client))
			assert viaLocal.contains("served")
			return none
		}

		@test()
		def TestPodsOverSpdy() !none {
			return none when testKubeconfig == ""
			let (cluster, namespace) = try testCluster()
			defer dropNamespace(cluster, namespace)
			let pods = cluster.pods(namespace)
			try runningPod(pods, "web", "mkdir -p /tmp/www; echo spdy > /tmp/www/index.html; httpd -f -p 8080 -h /tmp/www")
			let path = "/api/v1/namespaces/{namespace}/pods/web/exec"
			let query = streamQuery("", true, false)
			for let word in ["sh", "-c", "cat; echo err >&2; exit 4"] {
				query.add("command", word)
			}
			let opened = try openSpdyExec(cluster.core, path, query, true, false)
			let session = new ExecSession(opened.link, opened.inbound, opened.protocol, true, false)
			defer session.close()
			assert session.protocol == "v5.channel.k8s.io" || session.protocol == "v4.channel.k8s.io"
			try session.stdin.write("over spdy".bytes())
			try session.stdin.close()
			assert string(try session.stdout.readAll()) == "over spdy"
			assert string(try session.stderr.readAll()) == "err\n"
			assert try session.wait() == 4
			let spdy = try openSpdyForward(cluster.core, "/api/v1/namespaces/{namespace}/pods/web/portforward")
			defer spdy.close()
			for let _ in 0..2 {
				let (data, errors) = try spdy.stream(8080)
				let stream = new ForwardedStream(spdy.link, data.inbound, errors.inbound, 8080, false, data.id, errors.id)
				try stream.write("GET /index.html HTTP/1.0\r\n\r\n".bytes())
				let answer = string(try readStream(stream))
				assert answer.contains("spdy")
				try stream.close()
			}
			return none
		}

		@test()
		def TestWorkloads() !none {
			return none when testKubeconfig == ""
			let (cluster, namespace) = try testCluster()
			defer dropNamespace(cluster, namespace)
			let deployments = cluster.deployments(namespace)
			let made = new Deployment()
			made.name = "web"
			made.spec.replicas = 0
			made.spec.selector = LabelSelector{matchLabels: {"app": "web"}}
			made.spec.template.metadata.labels = {"app": "web"}
			made.spec.template.spec.containers = [Container{name: "web", image: "busybox:1.36", command: ["sleep", "3600"]}]
			let stored = try deployments.create(made)
			assert intOf(stored.spec.replicas) == 0
			let scaled = try deployments.scale("web", 2)
			assert scaled.spec.replicas == 2
			let read = try deployments.scaleOf("web")
			assert read.spec.replicas == 2
			let back = try deployments.get("web")
			assert intOf(back.spec.replicas) == 2
			// The deployment controller writes the status too: read again
			// when it wrote between the read and the update.
			let reported = try reportStatus(deployments, 99)
			assert reported.status.observedGeneration == 99
			let patched = try deployments.patchStatus("web", {"status": {"observedGeneration": 100}})
			assert patched.status.observedGeneration == 100
			try deployments.delete("web", Propagation.Foreground)
			let account = new ServiceAccount()
			account.name = "robot"
			try cluster.serviceAccounts(namespace).create(account)
			let token = try cluster.serviceAccounts(namespace).token("robot", expiration = 10min)
			assert token.status.token.split(".").len() == 3
			return none
		}

		@test()
		def TestInformer() !none {
			return none when testKubeconfig == ""
			let (cluster, namespace) = try testCluster()
			defer dropNamespace(cluster, namespace)
			let maps = cluster.configMaps(namespace)
			let first = new ConfigMap()
			first.name = "one"
			first.metadata.labels = {"set": "a"}
			try maps.create(first)
			let informer = maps.informer(labels = "set=a")
			let added = new channel<string>(16)
			let updated = new channel<string>(16)
			let deleted = new channel<string>(16)
			informer.onAdd = def (map ConfigMap) none {
				added <- map.name
			}
			informer.onUpdate = def (old ConfigMap, map ConfigMap) none {
				updated <- map.name
			}
			informer.onDelete = def (map ConfigMap) none {
				deleted <- map.name
			}
			informer.start()
			defer informer.close()
			try informer.waitForSync()
			assert <- added == "one"
			let second = new ConfigMap()
			second.name = "two"
			second.metadata.labels = {"set": "a"}
			try maps.create(second)
			assert <- added == "two"
			try maps.patch("one", {"data": {"k": "v"}})
			assert <- updated == "one"
			try maps.delete("two")
			assert <- deleted == "two"
			let cached = informer.get("one")
			assert !(cached is none) && cached.data["k"] == "v"
			assert informer.list().len() == 1
			return none
		}

		@test()
		def TestLeaderElection() !none {
			return none when testKubeconfig == ""
			let (cluster, namespace) = try testCluster()
			defer dropNamespace(cluster, namespace)
			let first = cluster.leaderElection("lock", "first", namespace)
			first.leaseDuration = 3s
			first.renewDeadline = 2s
			first.retryPeriod = 500ms
			let leading = new channel<string>(4)
			first.onStartedLeading = def () none {
				leading <- "first"
			}
			let firstRun = async first.run()
			assert <- leading == "first"
			let second = cluster.leaderElection("lock", "second", namespace)
			second.leaseDuration = 3s
			second.renewDeadline = 2s
			second.retryPeriod = 500ms
			second.onStartedLeading = def () none {
				leading <- "second"
			}
			let secondRun = async second.run()
			time.sleep(2s)
			assert first.isLeader() && !second.isLeader() && second.leader() == "first"
			// The first gives the lease up; the second takes it over.
			first.close()
			try await firstRun
			assert <- leading == "second"
			let lease = try cluster.leases(namespace).get("lock")
			assert holderOf(lease) == "second" && intOf(lease.spec.leaseTransitions) == 1
			second.close()
			try await secondRun
			return none
		}

		@test()
		def TestManifests() !none {
			return none when testKubeconfig == ""
			let (cluster, namespace) = try testCluster()
			defer dropNamespace(cluster, namespace)
			let crd = "apiVersion: apiextensions.k8s.io/v1\nkind: CustomResourceDefinition\nmetadata:\n  name: crontabs.adm.example.com\nspec:\n  group: adm.example.com\n  scope: Namespaced\n  names:\n    plural: crontabs\n    singular: crontab\n    kind: CronTab\n  versions:\n  - name: v1\n    served: true\n    storage: true\n    schema:\n      openAPIV3Schema:\n        type: object\n        properties:\n          spec:\n            type: object\n            properties:\n              cronSpec:\n                type: string\n              replicas:\n                type: integer\n"
			try cluster.apply(crd, fieldManager = "adm-test")
			defer dropDefinition(cluster, "crontabs.adm.example.com")
			let manifest = "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: from-yaml\ndata:\n  a: \"1\"\n---\napiVersion: adm.example.com/v1\nkind: CronTab\nmetadata:\n  name: nightly\nspec:\n  cronSpec: \"0 3 * * *\"\n  replicas: 2\n"
			let applied = try waitForApply(cluster, manifest, namespace)
			assert applied.len() == 2 && applied[0].namespace == namespace
			let tabs = try cluster.objects("adm.example.com/v1", "CronTab", namespace)
			let tab = try tabs.get("nightly")
			assert tab.text("spec.cronSpec") == "0 3 * * *"
			tab.set("spec.replicas", 3)
			let updated = try tabs.update(tab)
			assert intAt(updated, "spec.replicas") == 3
			let map = ConfigMap{}
			try applied[0].decode(map)
			assert map.data["a"] == "1"
			let written = writeManifests([map, tab])
			let again = try readManifests(written)
			assert again.len() == 2 && again[1].kind == "CronTab" && intAt(again[1], "spec.replicas") == 3
			return none
		}
	}

	internal def reportStatus(deployments Resources<Deployment>, generation int) !Deployment {
		for let _ in 0..10 {
			let current = try deployments.get("web")
			current.status.observedGeneration = generation
			let stored = tryUpdateStatus(deployments, current) onerror (err error) {
				fail err unless failureOf(err) == ErrorKind.Conflict
				recover none
			}
			return stored unless stored is none
		}
		fail "the status kept changing"
	}

	internal def tryUpdateStatus(deployments Resources<Deployment>, object Deployment) !?Deployment {
		return try deployments.updateStatus(object)
	}

	internal def dropDefinition(cluster Cluster, name string) {
		let definitions = cluster.objects(ResourceKind{group: "apiextensions.k8s.io", version: "v1", kind: "CustomResourceDefinition", plural: "customresourcedefinitions", namespaced: false})
		definitions.delete(name) onerror recover none
	}

	internal def intOf(value ?int) int {
		return value is none ?? (-1, value)
	}

	internal def intAt(object Unstructured, path string) int {
		let value = object.get(path)
		return value is int ?? (value, -1)
	}

	// Applies a manifest, again while the server has not served a custom
	// resource definition of it yet.
	internal def waitForApply(cluster Cluster, manifest string, namespace string) !Unstructured[] {
		for let _ in 0..40 {
			let applied = tryApply(cluster, manifest, namespace) onerror (err error) {
				fail err unless failureOf(err) == ErrorKind.NotFound
				recover none
			}
			return applied unless applied is none
			time.sleep(250ms)
		}
		return try cluster.apply(manifest, fieldManager = "adm-test", namespace = namespace)
	}

	internal def tryApply(cluster Cluster, manifest string, namespace string) !?Unstructured[] {
		return try cluster.apply(manifest, fieldManager = "adm-test", namespace = namespace)
	}

	// A pod of busybox running a script, once it runs.
	internal def runningPod(pods Resources<Pod>, name string, script string) !Pod {
		let made = new Pod()
		made.name = name
		let container = Container{name: name, image: "busybox:1.36", command: ["sh", "-c", script]}
		made.spec.containers = [container]
		made.spec.terminationGracePeriodSeconds = 0
		try pods.create(made)
		for let _ in 0..240 {
			let pod = try pods.get(name)
			return pod when pod.status.phase == "Running"
			fail "pod {name} ended: {pod.status.phase}" when pod.status.phase := "Failed" || "Succeeded"
			time.sleep(500ms)
		}
		fail "pod {name} did not start within two minutes"
	}

	// The log of a pod once it holds a text.
	internal def waitForLog(pods Resources<Pod>, name string, text string) !string {
		for let _ in 0..40 {
			let log = try pods.logs(name)
			return log when log.contains(text)
			time.sleep(250ms)
		}
		return try pods.logs(name)
	}

	// Everything a stream sends until it ends.
	internal def readStream(stream net.Stream) !byte[] {
		let out byte[] = []
		let buf byte[] = []
		buf.len(4096)
		for {
			let got = try stream.read(buf, 30s)
			break when got <= 0
			out.push(...buf[0:got])
		}
		return out
	}
}
