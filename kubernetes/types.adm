		// current number of healthy pods
		currentHealthy int = 0
		// minimum desired number of healthy pods
		desiredHealthy int = 0
		// DisruptedPods contains information about pods whose eviction was processed by the API
		// server eviction subresource handler but has not yet been observed by the
		// PodDisruptionBudget controller.
		@json(omitempty = true)
		disruptedPods map<string, time.Time> = {}
		// Number of pod disruptions that are currently allowed.
		disruptionsAllowed int = 0
		// total number of pods counted by this disruption budget
		expectedPods int = 0
		// Most recent generation observed when updating this PDB status.
		@json(omitempty = true)
		observedGeneration int = 0
	}

