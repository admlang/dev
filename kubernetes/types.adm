		// The phase of a Pod is a simple, high-level summary of where the Pod is in its lifecycle.
		@json(omitempty = true)
		phase string = ""
		// podIP address allocated to the pod.
		@json(omitempty = true)
		podIP string = ""
		// podIPs holds the IP addresses allocated to the pod.
		@json(omitempty = true)
		podIPs PodIP[] = []
		// The Quality of Service (QOS) classification assigned to the pod based on resource
		// requirements See PodQOSClass type for available QOS classes More info:
		// https://kubernetes.io/docs/concepts/workloads/pods/pod-qos/#quality-of-service-classes
		@json(omitempty = true)
		qosClass string = ""
		// A brief CamelCase message indicating details about why the pod is in this state.
		@json(omitempty = true)
		reason string = ""
		// Status of resources resize desired for pod's containers.
		@json(omitempty = true)
		resize string = ""
		// Status of resource claims.
		@json(omitempty = true)
		resourceClaimStatuses PodResourceClaimStatus[] = []
