		@json(omitempty = true)
		resources ?ResourceRequirements
		// Restart policy for all containers within the pod.
		@json(omitempty = true)
		restartPolicy string = ""
		// RuntimeClassName refers to a RuntimeClass object in the node.k8s.io group, which should
