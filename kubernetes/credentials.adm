// What a request carries to prove who sends it: a bearer token (given,
// read from a file, printed by an exec plugin, or an OIDC id token
// renewed with its refresh token), basic credentials, or a client
// certificate an exec plugin hands out.
internal partial module adm.dev.kubernetes.api {
	use (
		std.data.encoding::(JSON, json, base64decode, base64encode)
		std.time
		adm.dev.kubernetes.oidc
		adm.dev.kubernetes::*
	)

	// How long a token read from a file is used before the file is read
	// again: a pod's projected token is renewed in place well before it
	// expires.
	const tokenFileReread = 1min

	// How long before its expiry a credential is renewed.
	const renewLeeway = 10s

	// Credentials hand out the `Authorization` header of a request, and
	// renew what a plugin or a provider issued when it expires or the
	// server refuses it.
	type Credentials {
		config              Config
		internal from       Surroundings
		// What was issued last: a bearer token (from the token file, an
		// exec plugin, an OIDC provider) and until when it holds.
		internal issued     string                  = ""
		internal issuedTill ?time.Time              = none
		// When the token file was read.
		internal readAt     ?time.Time              = none
		// A client certificate an exec plugin issued, PEM.
		internal pluginCert string                  = ""
		internal pluginKey  ?Secret<string> = none
		// The OIDC provider's tokens as renewed.
		internal idToken    string                  = ""
		internal refresh    string                  = ""

		def new(config Config, from Surroundings) {
			self.config = config
			self.from = from
			let provider = config.authProvider
			if !(provider is none) {
				idToken = textAt(provider.config, "id-token")
				refresh = textAt(provider.config, "refresh-token")
			}
		}

		// Whether a refused request may succeed with renewed credentials:
		// they come from a plugin, a provider or a file.
		def renewable() bool {
			return !(config.exec is none) || !(config.authProvider is none) || config.tokenFile != ""
		}

		// Drops what was issued, so the next request asks again.
		atomic def invalidate() {
			issued = ""
			issuedTill = none
			readAt = none
			idToken = "" unless refresh == ""
		}

		// The `Authorization` header value; "" when the client proves who it
		// is with a certificate alone, or not at all.
		// Fails with ErrorKind.Denied when a plugin or a provider fails,
		// ErrorKind.Argument when the token file cannot be read.
		atomic def authorization() !string {
			let given = config.token
			return "Bearer {given.reveal()}" unless given is none
			if !(config.exec is none) {
				try runExec() unless fresh()
				return issued == "" ?? ("", "Bearer {issued}")
			}
			let provider = config.authProvider
			return "Bearer {try providerToken(provider)}" unless (provider is none)
			if config.tokenFile != "" {
				try readTokenFile() unless fresh()
				return "Bearer {issued}"
			}
			let password = config.password
			return "Basic {base64encode("{config.username}:{password.reveal()}".bytes())}" when config.username != "" && !(password is none)
			return ""
		}

		// The client certificate and key to present: the Config's, else an
		// exec plugin's (run first when it has not been).
		// Fails as `authorization` does.
		atomic def clientPair() !?(string, Secret<string>) {
			let key = config.clientKey
			return (config.clientCertificate, key) when config.clientCertificate != "" && !(key is none)
			return none when config.exec is none
			try runExec() unless fresh()
			let issuedKey = pluginKey
			return none when pluginCert == "" || issuedKey is none
			return (pluginCert, issuedKey)
		}

		// Whether what was issued last still holds.
		internal def fresh() bool {
			let till = issuedTill
			if config.tokenFile != "" && config.exec is none {
				let at = readAt
				return !(at is none) && time.now() - at < tokenFileReread
			}
			return false when issued == "" && pluginCert == ""
			return true when till is none
			return time.now() + renewLeeway < till
		}

		internal def readTokenFile() !none {
			let load = from.readFile
			let data = load(config.tokenFile) onerror (err error) {
				fail errorOf(ErrorKind.Argument, "kubernetes: cannot read the token file {config.tokenFile}: {err.message}", cause = err)
			}
			issued = string(data).trim()
			readAt = time.now()
			return none
		}

		// Runs the exec plugin and keeps what it printed.
		internal def runExec() !none {
			let program = config.exec
			fail errorOf(ErrorKind.Argument, "kubernetes: no exec plugin") when program is none
			fail errorOf(ErrorKind.Denied, "kubernetes: the exec plugin {program.command} needs a terminal (interactiveMode Always), which this program does not hand it") when program.interactiveMode == "Always"
			let env = program.env.clone()
			env["KUBERNETES_EXEC_INFO"] = string(new JSON().encode(execInfo(program, config)))
			let run = from.runPlugin
			let (output, code) = run(program.command, program.args, env) onerror (err error) {
				let hint = program.installHint == "" ?? ("", "\n{program.installHint}")
				fail errorOf(ErrorKind.Denied, "kubernetes: cannot run the exec plugin {program.command}: {err.message}{hint}", cause = err)
			}
			fail errorOf(ErrorKind.Denied, "kubernetes: the exec plugin {program.command} exited with {code}") unless code == 0
			let reply = ExecCredential{}
			new JSON().decode(output, reply) onerror (err error) {
				fail errorOf(ErrorKind.Denied, "kubernetes: the exec plugin {program.command} printed what is not an ExecCredential: {err.message}", cause = err)
			}
			fail errorOf(ErrorKind.Denied, "kubernetes: the exec plugin {program.command} printed kind {reply.kind}, not ExecCredential") unless reply.kind == "ExecCredential"
			let status = reply.status
			fail errorOf(ErrorKind.Denied, "kubernetes: the exec plugin {program.command} printed no status") when status is none
			fail errorOf(ErrorKind.Denied, "kubernetes: the exec plugin {program.command} printed neither a token nor a client certificate") when status.token == "" && status.clientCertificateData == ""
			fail errorOf(ErrorKind.Denied, "kubernetes: the exec plugin {program.command} printed a client certificate without its key") when (status.clientCertificateData == "") != (status.clientKeyData == "")
			issued = status.token
			issuedTill = status.expirationTimestamp
			pluginCert = status.clientCertificateData
			pluginKey = status.clientKeyData == "" ?? (none, new Secret<string>(status.clientKeyData))
			return none
		}

		// The OIDC provider's id token, renewed when it has expired.
		internal def providerToken(provider AuthProvider) !string {
			fail errorOf(ErrorKind.Denied, "kubernetes: the {provider.name} auth provider was removed from Kubernetes; use its exec plugin (kubelogin, gke-gcloud-auth-plugin)") unless provider.name == "oidc"
			return idToken when idToken != "" && !jwtExpired(idToken)
			let issuer = textAt(provider.config, "idp-issuer-url")
			let clientId = textAt(provider.config, "client-id")
			fail errorOf(ErrorKind.Denied, "kubernetes: the OIDC id token has expired and the auth provider has no refresh token") when refresh == ""
			fail errorOf(ErrorKind.Denied, "kubernetes: the OIDC auth provider has no idp-issuer-url or client-id to renew its token at") when issuer == "" || clientId == ""
			let ca = try pemOf(textAt(provider.config, "idp-certificate-authority-data"), textAt(provider.config, "idp-certificate-authority"), "", "the OIDC provider's certificate authority", from)
			let scopes = ["openid"]
			for let extra in textAt(provider.config, "extra-scopes").split(",") {
				scopes.push(extra.trim()) unless extra.trim() == ""
			}
			let (id, next) = oidc.renew(issuer, clientId, textAt(provider.config, "client-secret"), idToken, refresh, scopes, ca) onerror (err error) {
				fail errorOf(ErrorKind.Denied, "kubernetes: the OIDC provider {issuer} did not renew the token: {err.message}", cause = err)
			}
			idToken = id
			refresh = next
			return idToken
		}
	}

	// Whether a JWT's `exp` has passed, or will within the leeway; a token
	// that does not read as a JWT counts as expired.
	def jwtExpired(token string) bool {
		let parts = token.split(".")
		return true unless parts.len() == 3
		let payload = parts[1].replace("-", "+").replace("_", "/")
		payload = payload + "=".repeat((4 - payload.len() % 4) % 4)
		let data = base64decode(payload) onerror recover byte[]
		let claims = JwtExpiry{}
		new JSON().decode(data, claims) onerror recover none
		return true when claims.exp == 0
		return time.now() + renewLeeway >= time.fromUnixNs(int64(claims.exp) * 1000000000)
	}

	struct JwtExpiry {
		@json(omitempty = true)
		exp int = 0
	}

	// What an exec plugin prints.
	struct ExecCredential {
		@json(omitempty = true)
		apiVersion string = ""
		@json(omitempty = true)
		kind string = ""
		@json(omitempty = true)
		spec any
		@json(omitempty = true)
		status ?ExecCredentialStatus = none
	}

	struct ExecCredentialStatus {
		@json(omitempty = true)
		token string = ""
		@json(omitempty = true)
		clientCertificateData string = ""
		@json(omitempty = true)
		clientKeyData string = ""
		@json(omitempty = true)
		expirationTimestamp ?time.Time = none
	}

	// `KUBERNETES_EXEC_INFO`: the request a plugin answers, with the
	// cluster when the plugin asks for it.
	struct ExecInfo {
		apiVersion string
		kind       string       = "ExecCredential"
		spec       ExecInfoSpec = ExecInfoSpec{}
	}

	struct ExecInfoSpec {
		interactive bool = false
		@json(omitempty = true)
		cluster ?ExecCluster = none
	}

	struct ExecCluster {
		server string
		@json("tls-server-name", omitempty = true)
		tlsServerName string = ""
		@json("insecure-skip-tls-verify", omitempty = true)
		insecureSkipTlsVerify bool = false
		@json("certificate-authority-data", omitempty = true)
		certificateAuthorityData string = ""
		@json("proxy-url", omitempty = true)
		proxyUrl string = ""
		@json(omitempty = true)
		config any
	}

	def execInfo(program ExecPlugin, config Config) ExecInfo {
		let out = ExecInfo{apiVersion: program.apiVersion}
		if program.provideClusterInfo {
			let ca = config.certificateAuthority == "" ?? ("", base64encode(config.certificateAuthority.bytes()))
			out.spec.cluster = ExecCluster{server: config.server, tlsServerName: config.serverName, insecureSkipTlsVerify: config.insecureSkipVerify, certificateAuthorityData: ca, proxyUrl: config.proxy, config: program.clusterConfig}
		}
		return out
	}
}
