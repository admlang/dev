// SPDY/3.1 as the Kubernetes API server and kubelet speak it, for
// servers that take no WebSocket: streams opened with SYN_STREAM and
// headers naming what each carries, data frames, half-closes with FIN.
// The peers never send WINDOW_UPDATE, so no flow-control window is kept
// on either side; what they send is ignored rather than enforced.
internal partial module adm.dev.kubernetes.api {
	use (
		std.bytes
		std.data.compress.zlib
		std.io
		std.net
		std.net.http
		std.net.http.websocket
		std.net.url
		adm.dev.kubernetes::*
	)

	// Control frame types (SPDY/3 §2.6).
	const spdySynStream = 1
	const spdySynReply = 2
	const spdyRstStream = 3
	const spdySettings = 4
	const spdyPing = 6
	const spdyGoAway = 7
	const spdyHeaders = 8
	const spdyWindowUpdate = 9

	// The RST_STREAM status of a stream its sender is done with.
	const spdyCancel = 5

	// The FIN flag of a frame: the sender sends nothing more on the
	// stream.
	const spdyFin = 1

	// The longest data frame written; a larger write goes in several.
	const spdyFrameData = 32 * 1024

	// The longest frame read.
	const spdyLongestFrame = 16 * 1024 * 1024

	// SpdyStream is one stream of a connection: its id and what arrives
	// on it.
	type SpdyStream {
		id      int
		inbound Inbound

		def new(id int) {
			self.id = id
			inbound = new Inbound()
		}
	}

	// SpdyConn is a client's SPDY/3.1 connection, as the upgrade of an
	// exec, attach or port-forward request handed it over.
	type SpdyConn {
		internal stream       net.Stream
		internal source       io.Reader
		internal nextId       int                  = 1
		internal streams      map<int, SpdyStream> = {}
		internal sentHeaders  bytes.Buffer
		internal compressor   zlib.Writer
		internal decompressor zlib.Inflater
		internal atomic shut  bool                 = false
		internal reading      ?(async none)        = none

		def new(stream net.Stream, source io.Reader) {
			self.stream = stream
			self.source = new PrefixedReader(source, stream)
			sentHeaders = new bytes.Buffer()
			compressor = new zlib.Writer(sentHeaders, zlib.Level.DefaultCompression, spdyDictionary())
			decompressor = new zlib.Inflater(spdyDictionary())
		}

		// Starts reading frames in a task of its own.
		def start() {
			reading = async pump()
		}

		// open opens a stream with the headers given (names in lower case)
		// and returns it.
		// Fails as the connection does.
		atomic def open(headers map<string, string>) !SpdyStream {
			fail errorOf(ErrorKind.Closed, "kubernetes: the SPDY connection is closed") when shut
			let made = new SpdyStream(nextId)
			nextId += 2
			streams[made.id] = made
			let body byte[] = []
			body.push(...uint32Bytes(made.id))
			body.push(...uint32Bytes(0))
			body.push(0, 0)
			body.push(...try headerBlock(headers))
			try writeAll(controlFrame(spdySynStream, 0, body))
			return made
		}

		// Implements Link: data on a stream, in frames of at most 32 KiB.
		atomic def send(id int, data byte[]) !none {
			fail errorOf(ErrorKind.Closed, "kubernetes: the SPDY connection is closed") when shut
			let at = 0
			for at < data.len() {
				let end = (at + spdyFrameData) < data.len() ?? (at + spdyFrameData, data.len())
				try writeAll(dataFrame(id, 0, data[at:end]))
				at = end
			}
			return none
		}

		// Implements Link: an empty data frame with FIN.
		atomic def closeSend(id int) !bool {
			return true when shut
			try writeAll(dataFrame(id, spdyFin, []))
			return true
		}

		def close() {
			shut = true
			stream.close() onerror recover none
			for let (_, open) in streams {
				open.inbound.end()
			}
		}

		internal def writeAll(frame byte[]) !none {
			net.writeAll(stream, frame) onerror (err error) {
				fail transportError(err, "SPDY write")
			}
			return none
		}

		// A header block, compressed in the connection's one zlib stream
		// and flushed so the peer can read it at once.
		internal def headerBlock(headers map<string, string>) !byte[] {
			let plain byte[] = []
			plain.push(...uint32Bytes(headers.len()))
			for let (name, value) in headers {
				plain.push(...uint32Bytes(name.bytes().len()))
				plain.push(...name.lower().bytes())
				plain.push(...uint32Bytes(value.bytes().len()))
				plain.push(...value.bytes())
			}
			try compressor.write(plain)
			try compressor.flush()
			let out = sentHeaders.bytes()
			sentHeaders.reset()
			return out
		}

		// Reads frames until the connection ends, which ends every stream.
		def pump() {
			let failure ?error = none
			for !shut {
				let ok = readFrame() onerror (err error) {
					failure = err
					recover false
				}
				break unless ok
			}
			let ending = shut ?? (none, endOf(failure))
			for let (_, open) in streams {
				open.inbound.end(ending)
			}
		}

		// Reads one frame and acts on it; false at the end of the stream.
		internal def readFrame() !bool {
			let head byte[] = []
			head.len(8)
			let got = try readFully(head)
			return false when got == 0
			fail errorOf(ErrorKind.Protocol, "kubernetes: SPDY: the connection ended within a frame") when got < 8
			let length = int(head[5]) << 16 | int(head[6]) << 8 | int(head[7])
			fail errorOf(ErrorKind.Protocol, "kubernetes: SPDY: a frame of {length} bytes") when length > spdyLongestFrame
			let flags = int(head[4])
			let body byte[] = []
			body.len(length)
			if length > 0 {
				let read = try readFully(body)
				fail errorOf(ErrorKind.Protocol, "kubernetes: SPDY: the connection ended within a frame") when read < length
			}
			if (head[0] & 0x80) == 0 {
				let id = uint32Of(head, 0) & 0x7fffffff
				let target = streams.get(id)
				return true when target is none
				target.inbound.push(body)
				target.inbound.end() when (flags & spdyFin) != 0
				return true
			}
			let kind = int(head[2]) << 8 | int(head[3])
			switch kind {
				case spdySynReply, spdyHeaders:
					fail errorOf(ErrorKind.Protocol, "kubernetes: SPDY: a short header frame") when body.len() < 4
					// Read to keep the zlib stream in step; the server's
					// headers say nothing the client needs.
					try decompressor.feed(body[4:])
					let id = uint32Of(body, 0) & 0x7fffffff
					let target = streams.get(id)
					target.inbound.end() when !(target is none) && (flags & spdyFin) != 0
				case spdySynStream:
					fail errorOf(ErrorKind.Protocol, "kubernetes: SPDY: a short SYN_STREAM") when body.len() < 10
					try decompressor.feed(body[10:])
					// The client takes no streams the server opens.
					let id = uint32Of(body, 0) & 0x7fffffff
					let refusal byte[] = []
					refusal.push(...uint32Bytes(id))
					refusal.push(...uint32Bytes(3))
					try writeControl(spdyRstStream, refusal)
				case spdyRstStream:
					fail errorOf(ErrorKind.Protocol, "kubernetes: SPDY: a short RST_STREAM") when body.len() < 8
					let id = uint32Of(body, 0) & 0x7fffffff
					let target = streams.get(id)
					return true when target is none
					// The server ends a stream it is done with by CANCEL
					// rather than FIN.
					let status = uint32Of(body, 4)
					target.inbound.end(status == spdyCancel ?? (none, errorOf(ErrorKind.Connection, "kubernetes: SPDY: the server reset stream {id} (status {status})")))
				case spdyPing:
					// A ping the server sent (even id) goes back as it came.
					try writeControl(spdyPing, body) when body.len() == 4 && (uint32Of(body, 0) & 1) == 0
				case spdyGoAway:
					return false
			}
			return true
		}

		internal atomic def writeControl(kind int, body byte[]) !none {
			try writeAll(controlFrame(kind, 0, body))
			return none
		}

		// Fills buf from the connection: the bytes read, fewer only at its
		// end.
		internal def readFully(buf byte[]) !int {
			let have = 0
			for have < buf.len() {
				let got = source.read(buf[have:]) onerror (err error) {
					fail transportError(err, "SPDY read")
				}
				break when got <= 0
				have += got
			}
			return have
		}
	}

	def controlFrame(kind int, flags int, body byte[]) byte[] {
		let out byte[] = [0x80, 0x03, byte(kind >> 8), byte(kind & 0xff), byte(flags)]
		out.push(...uint24Bytes(body.len()))
		out.push(...body)
		return out
	}

	def dataFrame(id int, flags int, body byte[]) byte[] {
		let out byte[] = []
		out.push(...uint32Bytes(id & 0x7fffffff))
		out.push(byte(flags))
		out.push(...uint24Bytes(body.len()))
		out.push(...body)
		return out
	}

	def uint32Bytes(value int) byte[] {
		return [byte(value >> 24 & 0xff), byte(value >> 16 & 0xff), byte(value >> 8 & 0xff), byte(value & 0xff)]
	}

	def uint24Bytes(value int) byte[] {
		return [byte(value >> 16 & 0xff), byte(value >> 8 & 0xff), byte(value & 0xff)]
	}

	def uint32Of(data byte[], at int) int {
		return int(data[at]) << 24 | int(data[at + 1]) << 16 | int(data[at + 2]) << 8 | int(data[at + 3])
	}

	// An upgrade to SPDY/3.1 for a path, offering the stream protocols
	// given; the connection, reading, and the protocol the server chose.
	// Fails as Cluster's calls do.
	def openSpdy(core Core, path string, query url.Values, protocols string[]) !(SpdyConn, string) {
		let (stream, rest, chosen) = try core.upgrade(http.Method.POST, path, query, "SPDY/3.1", protocols)
		let conn = new SpdyConn(stream, rest)
		conn.start()
		return (conn, chosen)
	}

	// Opens the WebSocket of an exec, an attach or a port-forward; none
	// when the server does not take one, and speaks SPDY instead.
	// Fails as Cluster's calls do.
	def dialChannels(core Core, path string, query url.Values, protocols string[]) !?(websocket.Conn, string) {
		let failure ?error = none
		let opened = tryWebSocket(core, path, query, protocols) onerror (err error) {
			failure = err
			recover none
		}
		if !(failure is none) {
			return none when upgradeRefused(failure)
			fail failure
		}
		return opened
	}

	def tryWebSocket(core Core, path string, query url.Values, protocols string[]) !?(websocket.Conn, string) {
		return try core.openWebSocket(path, query, protocols)
	}

	// Whether a failed WebSocket upgrade means the server speaks only
	// SPDY: an answer that is not a refusal of the user or the object.
	def upgradeRefused(err error) bool {
		return false unless err is KubernetesError
		return false when err.status == 0 || (err.status := 401 || 403 || 404)
		return err.status < 500 || err.kind == ErrorKind.Protocol
	}

	// The streams of an exec or attach over SPDY.
	struct SpdyExec {
		link     Link
		inbound  map<int, Inbound>
		protocol string
	}

	// Opens an exec or attach over SPDY: the error stream, then standard
	// input, output and error, and the terminal's size, each that the
	// session uses.
	// Fails as Cluster's calls do.
	def openSpdyExec(core Core, path string, query url.Values, stdin bool, tty bool) !SpdyExec {
		let (conn, protocol) = try openSpdy(core, path, query, ["v5.channel.k8s.io", "v4.channel.k8s.io"])
		let inbound map<int, Inbound> = {}
		let channels map<int, int> = {}
		let wanted = [(channelError, "error")]
		wanted.push((channelStdin, "stdin")) when stdin
		wanted.push((channelStdout, "stdout"))
		wanted.push((channelStderr, "stderr")) unless tty
		wanted.push((channelResize, "resize")) when tty
		for let (_, entry) in wanted {
			let (channel, kind) = entry
			let opened = conn.open({"streamtype": kind}) onerror (err error) {
				conn.close()
				fail err
			}
			inbound[channel] = opened.inbound
			channels[channel] = opened.id
		}
		return SpdyExec{link: new SpdyChannels(conn, channels), inbound: inbound, protocol: protocol}
	}

	// SpdyChannels is a Link whose stream numbers are the channels of an
	// exec, each a SPDY stream of its own.
	type SpdyChannels {
		internal conn     SpdyConn
		internal channels map<int, int>

		def new(conn SpdyConn, channels map<int, int>) {
			self.conn = conn
			self.channels = channels
		}

		def send(channel int, data byte[]) !none {
			let id = channels.get(channel)
			fail errorOf(ErrorKind.Closed, "kubernetes: the session has no stream {channel}") when id is none
			try conn.send(id, data)
			return none
		}

		def closeSend(channel int) !bool {
			let id = channels.get(channel)
			return false when id is none
			return try conn.closeSend(id)
		}

		def close() {
			conn.close()
		}
	}

	// SpdyForward is a port-forward over SPDY: one connection, two
	// streams (data and errors) for each connection to a port.
	type SpdyForward {
		link              SpdyConn
		internal requests int      = 0

		def new(link SpdyConn) {
			self.link = link
		}

		// Opens a forward connection: its data stream and its error
		// stream.
		// Fails as Cluster's calls do.
		atomic def stream(port int) !(SpdyStream, SpdyStream) {
			let request = "{requests}"
			requests += 1
			let errors = try link.open({"streamtype": "error", "port": "{port}", "requestid": request})
			try link.closeSend(errors.id)
			let data = try link.open({"streamtype": "data", "port": "{port}", "requestid": request})
			return (data, errors)
		}

		def close() {
			link.close()
		}
	}

	// Opens a port-forward connection over SPDY.
	// Fails as Cluster's calls do.
	def openSpdyForward(core Core, path string) !SpdyForward {
		let (conn, _) = try openSpdy(core, path, new url.Values(), ["portforward.k8s.io"])
		return new SpdyForward(conn)
	}

	// The dictionary SPDY/3 header blocks are compressed against (SPDY/3
	// §2.6.10.1).
	def spdyDictionary() byte[] {
		return byte[
		0x00, 0x00, 0x00, 0x07, 0x6f, 0x70, 0x74, 0x69, 0x6f, 0x6e, 0x73, 0x00, 0x00, 0x00, 0x04, 0x68,
		0x65, 0x61, 0x64, 0x00, 0x00, 0x00, 0x04, 0x70, 0x6f, 0x73, 0x74, 0x00, 0x00, 0x00, 0x03, 0x70,
		0x75, 0x74, 0x00, 0x00, 0x00, 0x06, 0x64, 0x65, 0x6c, 0x65, 0x74, 0x65, 0x00, 0x00, 0x00, 0x05,
		0x74, 0x72, 0x61, 0x63, 0x65, 0x00, 0x00, 0x00, 0x06, 0x61, 0x63, 0x63, 0x65, 0x70, 0x74, 0x00,
		0x00, 0x00, 0x0e, 0x61, 0x63, 0x63, 0x65, 0x70, 0x74, 0x2d, 0x63, 0x68, 0x61, 0x72, 0x73, 0x65,
		0x74, 0x00, 0x00, 0x00, 0x0f, 0x61, 0x63, 0x63, 0x65, 0x70, 0x74, 0x2d, 0x65, 0x6e, 0x63, 0x6f,
		0x64, 0x69, 0x6e, 0x67, 0x00, 0x00, 0x00, 0x0f, 0x61, 0x63, 0x63, 0x65, 0x70, 0x74, 0x2d, 0x6c,
		0x61, 0x6e, 0x67, 0x75, 0x61, 0x67, 0x65, 0x00, 0x00, 0x00, 0x0d, 0x61, 0x63, 0x63, 0x65, 0x70,
		0x74, 0x2d, 0x72, 0x61, 0x6e, 0x67, 0x65, 0x73, 0x00, 0x00, 0x00, 0x03, 0x61, 0x67, 0x65, 0x00,
		0x00, 0x00, 0x05, 0x61, 0x6c, 0x6c, 0x6f, 0x77, 0x00, 0x00, 0x00, 0x0d, 0x61, 0x75, 0x74, 0x68,
		0x6f, 0x72, 0x69, 0x7a, 0x61, 0x74, 0x69, 0x6f, 0x6e, 0x00, 0x00, 0x00, 0x0d, 0x63, 0x61, 0x63,
		0x68, 0x65, 0x2d, 0x63, 0x6f, 0x6e, 0x74, 0x72, 0x6f, 0x6c, 0x00, 0x00, 0x00, 0x0a, 0x63, 0x6f,
		0x6e, 0x6e, 0x65, 0x63, 0x74, 0x69, 0x6f, 0x6e, 0x00, 0x00, 0x00, 0x0c, 0x63, 0x6f, 0x6e, 0x74,
		0x65, 0x6e, 0x74, 0x2d, 0x62, 0x61, 0x73, 0x65, 0x00, 0x00, 0x00, 0x10, 0x63, 0x6f, 0x6e, 0x74,
		0x65, 0x6e, 0x74, 0x2d, 0x65, 0x6e, 0x63, 0x6f, 0x64, 0x69, 0x6e, 0x67, 0x00, 0x00, 0x00, 0x10,
		0x63, 0x6f, 0x6e, 0x74, 0x65, 0x6e, 0x74, 0x2d, 0x6c, 0x61, 0x6e, 0x67, 0x75, 0x61, 0x67, 0x65,
		0x00, 0x00, 0x00, 0x0e, 0x63, 0x6f, 0x6e, 0x74, 0x65, 0x6e, 0x74, 0x2d, 0x6c, 0x65, 0x6e, 0x67,
		0x74, 0x68, 0x00, 0x00, 0x00, 0x10, 0x63, 0x6f, 0x6e, 0x74, 0x65, 0x6e, 0x74, 0x2d, 0x6c, 0x6f,
		0x63, 0x61, 0x74, 0x69, 0x6f, 0x6e, 0x00, 0x00, 0x00, 0x0b, 0x63, 0x6f, 0x6e, 0x74, 0x65, 0x6e,
		0x74, 0x2d, 0x6d, 0x64, 0x35, 0x00, 0x00, 0x00, 0x0d, 0x63, 0x6f, 0x6e, 0x74, 0x65, 0x6e, 0x74,
		0x2d, 0x72, 0x61, 0x6e, 0x67, 0x65, 0x00, 0x00, 0x00, 0x0c, 0x63, 0x6f, 0x6e, 0x74, 0x65, 0x6e,
		0x74, 0x2d, 0x74, 0x79, 0x70, 0x65, 0x00, 0x00, 0x00, 0x04, 0x64, 0x61, 0x74, 0x65, 0x00, 0x00,
		0x00, 0x04, 0x65, 0x74, 0x61, 0x67, 0x00, 0x00, 0x00, 0x06, 0x65, 0x78, 0x70, 0x65, 0x63, 0x74,
		0x00, 0x00, 0x00, 0x07, 0x65, 0x78, 0x70, 0x69, 0x72, 0x65, 0x73, 0x00, 0x00, 0x00, 0x04, 0x66,
		0x72, 0x6f, 0x6d, 0x00, 0x00, 0x00, 0x04, 0x68, 0x6f, 0x73, 0x74, 0x00, 0x00, 0x00, 0x08, 0x69,
		0x66, 0x2d, 0x6d, 0x61, 0x74, 0x63, 0x68, 0x00, 0x00, 0x00, 0x11, 0x69, 0x66, 0x2d, 0x6d, 0x6f,
		0x64, 0x69, 0x66, 0x69, 0x65, 0x64, 0x2d, 0x73, 0x69, 0x6e, 0x63, 0x65, 0x00, 0x00, 0x00, 0x0d,
		0x69, 0x66, 0x2d, 0x6e, 0x6f, 0x6e, 0x65, 0x2d, 0x6d, 0x61, 0x74, 0x63, 0x68, 0x00, 0x00, 0x00,
		0x08, 0x69, 0x66, 0x2d, 0x72, 0x61, 0x6e, 0x67, 0x65, 0x00, 0x00, 0x00, 0x13, 0x69, 0x66, 0x2d,
		0x75, 0x6e, 0x6d, 0x6f, 0x64, 0x69, 0x66, 0x69, 0x65, 0x64, 0x2d, 0x73, 0x69, 0x6e, 0x63, 0x65,
		0x00, 0x00, 0x00, 0x0d, 0x6c, 0x61, 0x73, 0x74, 0x2d, 0x6d, 0x6f, 0x64, 0x69, 0x66, 0x69, 0x65,
		0x64, 0x00, 0x00, 0x00, 0x08, 0x6c, 0x6f, 0x63, 0x61, 0x74, 0x69, 0x6f, 0x6e, 0x00, 0x00, 0x00,
		0x0c, 0x6d, 0x61, 0x78, 0x2d, 0x66, 0x6f, 0x72, 0x77, 0x61, 0x72, 0x64, 0x73, 0x00, 0x00, 0x00,
		0x06, 0x70, 0x72, 0x61, 0x67, 0x6d, 0x61, 0x00, 0x00, 0x00, 0x12, 0x70, 0x72, 0x6f, 0x78, 0x79,
		0x2d, 0x61, 0x75, 0x74, 0x68, 0x65, 0x6e, 0x74, 0x69, 0x63, 0x61, 0x74, 0x65, 0x00, 0x00, 0x00,
		0x13, 0x70, 0x72, 0x6f, 0x78, 0x79, 0x2d, 0x61, 0x75, 0x74, 0x68, 0x6f, 0x72, 0x69, 0x7a, 0x61,
		0x74, 0x69, 0x6f, 0x6e, 0x00, 0x00, 0x00, 0x05, 0x72, 0x61, 0x6e, 0x67, 0x65, 0x00, 0x00, 0x00,
		0x07, 0x72, 0x65, 0x66, 0x65, 0x72, 0x65, 0x72, 0x00, 0x00, 0x00, 0x0b, 0x72, 0x65, 0x74, 0x72,
		0x79, 0x2d, 0x61, 0x66, 0x74, 0x65, 0x72, 0x00, 0x00, 0x00, 0x06, 0x73, 0x65, 0x72, 0x76, 0x65,
		0x72, 0x00, 0x00, 0x00, 0x02, 0x74, 0x65, 0x00, 0x00, 0x00, 0x07, 0x74, 0x72, 0x61, 0x69, 0x6c,
		0x65, 0x72, 0x00, 0x00, 0x00, 0x11, 0x74, 0x72, 0x61, 0x6e, 0x73, 0x66, 0x65, 0x72, 0x2d, 0x65,
		0x6e, 0x63, 0x6f, 0x64, 0x69, 0x6e, 0x67, 0x00, 0x00, 0x00, 0x07, 0x75, 0x70, 0x67, 0x72, 0x61,
		0x64, 0x65, 0x00, 0x00, 0x00, 0x0a, 0x75, 0x73, 0x65, 0x72, 0x2d, 0x61, 0x67, 0x65, 0x6e, 0x74,
