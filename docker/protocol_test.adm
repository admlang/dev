// The protocol suite: hosts and contexts, registry credentials, build
// contexts, request bodies and the engine's streams, and a loopback server
// that answers as the engine does. No engine needed.
partial module adm.dev.docker {
	use (
		std.bytes
		std.crypto.hash::(SHA256)
		std.data.encoding
		std.net.http
		std.net.http.httptest
		std.testing
		std.time
		adm.dev.docker.api::*
	)

