		@json(omitempty = true)
		portBindings map<string, PortBinding[]>
		@json(omitempty = true)
		restartPolicy ?RestartPolicy
		@json(omitempty = true)
		autoRemove bool
		@json(omitempty = true)
		mounts MountBody[]
		@json(omitempty = true)
		capAdd string[]
		@json(omitempty = true)
		capDrop string[]
		@json(omitempty = true)
		dns string[]
		@json(omitempty = true)
		dnsOptions string[]
		@json(omitempty = true)
		dnsSearch string[]
		@json(omitempty = true)
		extraHosts string[]
		@json(omitempty = true)
		groupAdd string[]
		@json(omitempty = true)
		ipcMode string
		@json(omitempty = true)
		pidMode string
		@json(omitempty = true)
		privileged bool
		@json(omitempty = true)
		publishAllPorts bool
		@json(omitempty = true)
		readonlyRootfs bool
		@json(omitempty = true)
		securityOpt string[]
		@json(omitempty = true)
		tmpfs map<string, string>
		@json(omitempty = true)
		usernsMode string
		@json(omitempty = true)
		shmSize int
		@json(omitempty = true)
		sysctls map<string, string>
		@json(omitempty = true)
		runtime string
		@json(omitempty = true)
		init bool
		@json(omitempty = true)
		logConfig ?LogConfig
		@json(omitempty = true)
		memory int
		@json(omitempty = true)
		memorySwap int
		@json(omitempty = true)
		memoryReservation int
		@json(omitempty = true)
		nanoCpus int
		@json(omitempty = true)
		cpuShares int
		@json(omitempty = true)
		cpusetCpus string
		@json(omitempty = true)
		pidsLimit int
		@json(omitempty = true)
		ulimits Ulimit[]
		@json(omitempty = true)
		devices DeviceMapping[]
		@json(omitempty = true)
		deviceRequests DeviceRequestBody[]
		@json(omitempty = true)
		volumesFrom string[]
		@json(omitempty = true)
		links string[]
		@json(omitempty = true)
		cgroupParent string
		@json(omitempty = true)
		cgroupnsMode string
		@json(omitempty = true)
		oomScoreAdj int
		@json(omitempty = true)
		oomKillDisable bool
		@json(omitempty = true)
		memorySwappiness ?int
		@json(omitempty = true)
		blkioWeight int
		@json(omitempty = true)
		blkioWeightDevice WeightDevice[]
		@json(omitempty = true)
		blkioDeviceReadBps ThrottleDevice[]
		@json(omitempty = true)
		blkioDeviceWriteBps ThrottleDevice[]
		@json(omitempty = true)
		blkioDeviceReadIOps ThrottleDevice[]
		@json(omitempty = true)
		blkioDeviceWriteIOps ThrottleDevice[]
		@json(omitempty = true)
		cpuPeriod int
		@json(omitempty = true)
		cpuQuota int
		@json(omitempty = true)
		cpuRealtimePeriod int
		@json(omitempty = true)
		cpuRealtimeRuntime int
