		@json(omitempty = true)
		annotations map<string, string>
	}

	struct MountBody {
		@json("Type")
		kind string
		@json(omitempty = true)
		source string
		target string
		@json(omitempty = true)
		readOnly bool
		@json(omitempty = true)
		bindOptions ?BindOptionsBody
		@json(omitempty = true)
		volumeOptions ?VolumeOptionsBody
		@json(omitempty = true)
		tmpfsOptions ?TmpfsOptionsBody
	}

	struct BindOptionsBody {
		propagation string
	}

	struct VolumeOptionsBody {
		@json(omitempty = true)
		noCopy bool
		@json(omitempty = true)
		labels map<string, string>
		@json(omitempty = true)
		driverConfig ?DriverConfigBody
	}

	struct DriverConfigBody {
		name string
		@json(omitempty = true)
		options map<string, string>
	}

	struct TmpfsOptionsBody {
		@json(omitempty = true)
		sizeBytes int
		@json(omitempty = true)
		mode int
	}

	struct DeviceRequestBody {
		@json(omitempty = true)
		driver string
		count int
		@json("DeviceIDs", omitempty = true)
		deviceIds string[]
		@json(omitempty = true)
		capabilities string[][]
		@json(omitempty = true)
		options map<string, string>
	}

	struct NetworkingBody {
		endpointsConfig map<string, EndpointBody>
	}

	struct EndpointBody {
		@json("IPAMConfig", omitempty = true)
		ipamConfig ?EndpointAddresses
		@json(omitempty = true)
		aliases string[]
		@json(omitempty = true)
		links string[]
		@json(omitempty = true)
		driverOpts map<string, string>
		@json(omitempty = true)
		macAddress string
		@json(omitempty = true)
		gwPriority int
	}

	struct EndpointAddresses {
		@json("IPv4Address", omitempty = true)
		ipv4Address string
		@json("IPv6Address", omitempty = true)
		ipv6Address string
		@json("LinkLocalIPs", omitempty = true)
		linkLocalIPs string[]
	}

	// The body of a container create.
	// createBody is the create request for `spec` on an engine speaking
	// `apiVersion` ("" for the newest the client knows): a field the version
	// predates is left out.
	def createBody(spec ContainerSpec, apiVersion string = "") CreateBody {
		let body = CreateBody{image: spec.image, cmd: spec.cmd, entrypoint: spec.entrypoint, labels: spec.labels, workingDir: spec.workingDir, user: spec.user, hostname: spec.hostname, domainname: spec.domainname, tty: spec.tty, openStdin: spec.openStdin, stdinOnce: spec.stdinOnce, attachStdin: spec.openStdin, stopSignal: spec.stopSignal, shell: spec.shell}
		for let (name, value) in spec.env {
			body.env.push("{name}={value}")
		}
		let exposed = new map<string, map<string, string>>()
		for let port in spec.exposedPorts {
			exposed.set(withProtocol(port), new map<string, string>())
		}
		let stop = spec.stopTimeout
		body.stopTimeout = int(stop.nanoseconds() / int64(1000000000)) unless stop is none
		let health = spec.healthcheck
		body.healthcheck = HealthBody{test: health.test, interval: int(health.interval.nanoseconds()), timeout: int(health.timeout.nanoseconds()), retries: health.retries, startPeriod: int(health.startPeriod.nanoseconds()), startInterval: int(health.startInterval.nanoseconds())} unless (health is none)
		let anonymous = new map<string, map<string, string>>()
		for let path in spec.volumes {
			anonymous.set(path, new map<string, string>())
		}
		body.volumes = anonymous
		let host = HostBody{binds: spec.binds, networkMode: spec.network, restartPolicy: spec.restart, autoRemove: spec.autoRemove, capAdd: spec.capAdd, capDrop: spec.capDrop, dns: spec.dns, dnsOptions: spec.dnsOptions, dnsSearch: spec.dnsSearch, extraHosts: spec.extraHosts, groupAdd: spec.groupAdd, ipcMode: spec.ipcMode, pidMode: spec.pidMode, privileged: spec.privileged, publishAllPorts: spec.publishAll, readonlyRootfs: spec.readonlyRootfs, securityOpt: spec.securityOpt, tmpfs: spec.tmpfs, usernsMode: spec.usernsMode, shmSize: spec.shmSize, sysctls: spec.sysctls, runtime: spec.runtime, init: spec.init, logConfig: spec.logConfig, memory: spec.memory, memorySwap: spec.memorySwap, memoryReservation: spec.memoryReservation, nanoCpus: int(spec.cpus * 1000000000.0), cpuShares: spec.cpuShares, cpusetCpus: spec.cpusetCpus, pidsLimit: spec.pidsLimit, ulimits: spec.ulimits, devices: spec.devices, volumesFrom: spec.volumesFrom, links: spec.links, cgroupParent: spec.cgroupParent, cgroupnsMode: spec.cgroupnsMode, oomScoreAdj: spec.oomScoreAdj, oomKillDisable: spec.oomKillDisable, memorySwappiness: spec.memorySwappiness, blkioWeight: spec.blkioWeight, blkioWeightDevice: spec.blkioWeightDevice, blkioDeviceReadBps: spec.blkioDeviceReadBps, blkioDeviceWriteBps: spec.blkioDeviceWriteBps, blkioDeviceReadIOps: spec.blkioDeviceReadIOps, blkioDeviceWriteIOps: spec.blkioDeviceWriteIOps, cpuPeriod: spec.cpuPeriod, cpuQuota: spec.cpuQuota, cpuRealtimePeriod: spec.cpuRealtimePeriod, cpuRealtimeRuntime: spec.cpuRealtimeRuntime, cpuCount: spec.cpuCount, cpuPercent: spec.cpuPercent, deviceCgroupRules: spec.deviceCgroupRules, storageOpt: spec.storageOpt, utsMode: spec.utsMode, isolation: spec.isolation}
		host.annotations = spec.annotations when versionHas(apiVersion, "1.43")
		let bindings = new map<string, PortBinding[]>()
		for let (port, hostPort) in spec.ports {
			let key = withProtocol(port)
			bindings.set(key, [PortBinding{hostIp: "", hostPort: hostPort.str()}])
			exposed.set(key, new map<string, string>())
		}
		for let (port, list) in spec.portBindings {
			let key = withProtocol(port)
			bindings.set(key, list)
			exposed.set(key, new map<string, string>())
		}
		body.exposedPorts = exposed
		host.portBindings = bindings
		for let mount in spec.mounts {
			host.mounts.push(mountBody(mount))
		}
		for let request in spec.deviceRequests {
			host.deviceRequests.push(DeviceRequestBody{driver: request.driver, count: request.count, deviceIds: request.deviceIds, capabilities: request.capabilities, options: request.options})
		}
		body.hostConfig = host
		if spec.networks.len() > 0 {
			let endpoints = new map<string, EndpointBody>()
			for let (name, endpoint) in spec.networks {
				endpoints.set(name, endpointBody(endpoint, apiVersion))
			}
			body.networkingConfig = NetworkingBody{endpointsConfig: endpoints}
		}
		return body
	}

	// A container port with its protocol: `80` is `80/tcp`.
	def withProtocol(port string) string {
		return port.contains("/") ?? (port, "{port}/tcp")
	}

	def mountBody(mount Mount) MountBody {
		let out = MountBody{kind: mount.kind.value, source: mount.source, target: mount.target, readOnly: mount.readOnly}
		match mount.kind {
			case MountKind.Bind:
				out.bindOptions = BindOptionsBody{propagation: mount.propagation} unless mount.propagation == ""
			case MountKind.Volume:
				if mount.noCopy || mount.volumeLabels.len() > 0 || mount.volumeDriver != "" {
					let options = VolumeOptionsBody{noCopy: mount.noCopy, labels: mount.volumeLabels}
					options.driverConfig = DriverConfigBody{name: mount.volumeDriver, options: mount.volumeOptions} unless mount.volumeDriver == ""
					out.volumeOptions = options
				}
			case MountKind.Tmpfs:
				out.tmpfsOptions = TmpfsOptionsBody{sizeBytes: mount.tmpfsSize, mode: mount.tmpfsMode} when mount.tmpfsSize > 0 || mount.tmpfsMode > 0
			default:
		}
		return out
	}

	// versionHas reports whether an engine speaking `apiVersion` knows a
	// field `since` introduced; "" stands for the newest version.
	def versionHas(apiVersion string, since string) bool {
		return apiVersion == "" || !olderThan(apiVersion, since)
	}

	def endpointBody(endpoint NetworkEndpoint, apiVersion string = "") EndpointBody {
		let out = EndpointBody{aliases: endpoint.aliases, links: endpoint.links, driverOpts: endpoint.driverOpts}
		out.ipamConfig = EndpointAddresses{ipv4Address: endpoint.ipv4Address, ipv6Address: endpoint.ipv6Address, linkLocalIPs: endpoint.linkLocalIPs} unless endpoint.ipv4Address == "" && endpoint.ipv6Address == "" && endpoint.linkLocalIPs.len() == 0
		out.macAddress = endpoint.macAddress when versionHas(apiVersion, "1.44")
		out.gwPriority = endpoint.gwPriority when versionHas(apiVersion, "1.48")
		return out
	}
}
