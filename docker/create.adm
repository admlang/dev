// The body of `POST /containers/create`: a ContainerSpec in the API's
// shape, every field the spec leaves empty left out so the image's and the
// engine's defaults hold.
internal partial module adm.dev.docker.api {
	use (
		std.data.encoding
		adm.dev.docker::*
	)

	struct CreateBody {
