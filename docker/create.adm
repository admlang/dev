		hostname string
		@json(omitempty = true)
		domainname string
		@json(omitempty = true)
		user string
		attachStdin bool
		attachStdout bool = true
		attachStderr bool = true
		@json(omitempty = true)
		exposedPorts map<string, map<string, string>>
		@json(omitempty = true)
		tty bool
		@json(omitempty = true)
		openStdin bool
		@json(omitempty = true)
		stdinOnce bool
		@json(omitempty = true)
		env string[]
		@json(omitempty = true)
		cmd string[]
		@json(omitempty = true)
		healthcheck ?HealthBody
		image string
		@json(omitempty = true)
		volumes map<string, map<string, string>>
		@json(omitempty = true)
		workingDir string
		@json(omitempty = true)
		entrypoint string[]
		@json(omitempty = true)
		labels map<string, string>
		@json(omitempty = true)
		stopSignal string
		@json(omitempty = true)
		stopTimeout ?int
		@json(omitempty = true)
		shell string[]
		hostConfig HostBody
		@json(omitempty = true)
		networkingConfig ?NetworkingBody
	}

	struct HealthBody {
