	// Webhooks for repositories.
	struct Hook {
		@json("type", omitempty = true)
		typeName string = ""
		// Unique identifier of the webhook.
		@json(omitempty = true)
		id int = 0
		// The name of a valid service, use 'web' for a webhook.
		@json(omitempty = true)
		name string = ""
		// Determines whether the hook is actually triggered on pushes.
		@json(omitempty = true)
		active bool = false
		// Determines what events the hook is triggered for.
		@json(omitempty = true)
		events string[] = []
		// Configuration object of the webhook
		@json(omitempty = true)
		config WebhookConfig = WebhookConfig{}
		@json("updated_at", omitempty = true)
		updatedAt time.Time = time.Time{}
		@json("created_at", omitempty = true)
		createdAt time.Time = time.Time{}
		@json(omitempty = true)
		url string = ""
		@json("test_url", omitempty = true)
		testUrl string = ""
		@json("ping_url", omitempty = true)
		pingUrl string = ""
		@json("deliveries_url", omitempty = true)
		deliveriesUrl string = ""
		@json("last_response", omitempty = true)
		lastResponse HookResponse = HookResponse{}
	}

	// Delivery made by a webhook.
	struct HookDelivery {
		// Unique identifier of the delivery.
		@json(omitempty = true)
		id int = 0
		// Unique identifier for the event (shared with all deliveries for all webhooks that
		// subscribe to this event).
		@json(omitempty = true)
		guid string = ""
		// Time when the delivery was delivered.
		@json("delivered_at", omitempty = true)
		deliveredAt time.Time = time.Time{}
		// Whether the delivery is a redelivery.
		@json(omitempty = true)
		redelivery bool = false
		// Time spent delivering.
		@json(omitempty = true)
		duration float = 0.0
		// Description of the status of the attempted delivery
		@json(omitempty = true)
		status string = ""
		// Status code received when delivery was made.
		@json("status_code", omitempty = true)
		statusCode int = 0
		// The event that triggered the delivery.
		@json(omitempty = true)
		event string = ""
		// The type of activity for the event that triggered the delivery.
		@json(omitempty = true)
		action ?string
		// The id of the GitHub App installation associated with this event.
		@json("installation_id", omitempty = true)
		installationId ?int
		// The id of the repository associated with this event.
		@json("repository_id", omitempty = true)
		repositoryId ?int
		// Time when the webhook delivery was throttled.
		@json("throttled_at", omitempty = true)
		throttledAt ?time.Time
		// The URL target of the delivery.
		@json(omitempty = true)
		url string = ""
		@json(omitempty = true)
		request HookDeliveryRequest = HookDeliveryRequest{}
		@json(omitempty = true)
		response HookDeliveryResponse = HookDeliveryResponse{}
	}

	// Delivery made by a webhook, without request and response information.
	struct HookDeliveryItem {
		// Unique identifier of the webhook delivery.
		@json(omitempty = true)
		id int = 0
		// Unique identifier for the event (shared with all deliveries for all webhooks that
		// subscribe to this event).
		@json(omitempty = true)
		guid string = ""
		// Time when the webhook delivery occurred.
		@json("delivered_at", omitempty = true)
		deliveredAt time.Time = time.Time{}
		// Whether the webhook delivery is a redelivery.
		@json(omitempty = true)
		redelivery bool = false
		// Time spent delivering.
		@json(omitempty = true)
		duration float = 0.0
		// Describes the response returned after attempting the delivery.
		@json(omitempty = true)
		status string = ""
		// Status code received when delivery was made.
		@json("status_code", omitempty = true)
		statusCode int = 0
		// The event that triggered the delivery.
		@json(omitempty = true)
		event string = ""
		// The type of activity for the event that triggered the delivery.
		@json(omitempty = true)
		action ?string
		// The id of the GitHub App installation associated with this event.
		@json("installation_id", omitempty = true)
		installationId ?int
		// The id of the repository associated with this event.
		@json("repository_id", omitempty = true)
		repositoryId ?int
		// Time when the webhook delivery was throttled.
		@json("throttled_at", omitempty = true)
		throttledAt ?time.Time
	}

	// HookDeliveryRequest
	struct HookDeliveryRequest {
		// The request headers sent with the webhook delivery.
		@json(omitempty = true)
		headers map<string, any> = {}
		// The webhook payload.
		@json(omitempty = true)
		payload map<string, any> = {}
	}

	// HookDeliveryResponse
	struct HookDeliveryResponse {
		// The response headers received when the delivery was made.
		@json(omitempty = true)
		headers map<string, any> = {}
		// The response payload received.
		@json(omitempty = true)
		payload ?string
	}

