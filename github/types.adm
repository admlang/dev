	// A repository security advisory.
	struct RepositoryAdvisory {
		// The GitHub Security Advisory ID.
		@json("ghsa_id", omitempty = true)
		ghsaId string = ""
		// The Common Vulnerabilities and Exposures (CVE) ID.
		@json("cve_id", omitempty = true)
		cveId ?string
		// The API URL for the advisory.
		@json(omitempty = true)
		url string = ""
		// The URL for the advisory.
		@json("html_url", omitempty = true)
		htmlUrl string = ""
		// A short summary of the advisory.
		@json(omitempty = true)
		summary string = ""
		// A detailed description of what the advisory entails.
		@json(omitempty = true)
		description ?string
		// The severity of the advisory.
		@json(omitempty = true)
		severity ?string
		// The author of the advisory.
		@json(omitempty = true)
		author ?RepositoryAdvisoryAuthor
		// The publisher of the advisory.
		@json(omitempty = true)
		publisher ?RepositoryAdvisoryPublisher
		@json(omitempty = true)
		identifiers RepositoryAdvisoryIdentifiersItem[] = []
		// The state of the advisory.
		@json(omitempty = true)
		state string = ""
		// The date and time of when the advisory was created, in ISO 8601 format.
		@json("created_at", omitempty = true)
		createdAt ?time.Time
		// The date and time of when the advisory was last updated, in ISO 8601 format.
		@json("updated_at", omitempty = true)
		updatedAt ?time.Time
		// The date and time of when the advisory was published, in ISO 8601 format.
		@json("published_at", omitempty = true)
		publishedAt ?time.Time
		// The date and time of when the advisory was closed, in ISO 8601 format.
		@json("closed_at", omitempty = true)
		closedAt ?time.Time
		// The date and time of when the advisory was withdrawn, in ISO 8601 format.
		@json("withdrawn_at", omitempty = true)
		withdrawnAt ?time.Time
		@json(omitempty = true)
		submission ?RepositoryAdvisorySubmission
		@json(omitempty = true)
		vulnerabilities RepositoryAdvisoryVulnerability[] = []
		@json(omitempty = true)
		cvss ?RepositoryAdvisoryCvss
		@json("cvss_severities", omitempty = true)
		cvssSeverities ?CvssSeverities
		@json(omitempty = true)
		cwes RepositoryAdvisoryCwesItem[] = []
		// A list of only the CWE IDs.
		@json("cwe_ids", omitempty = true)
		cweIds string[] = []
		@json(omitempty = true)
		credits RepositoryAdvisoryCreditsItem[] = []
		@json("credits_detailed", omitempty = true)
		creditsDetailed RepositoryAdvisoryCredit[] = []
		// A list of users that collaborate on the advisory.
		@json("collaborating_users", omitempty = true)
		collaboratingUsers SimpleUser[] = []
		// A list of teams that collaborate on the advisory.
		@json("collaborating_teams", omitempty = true)
		collaboratingTeams Team[] = []
		// A temporary private fork of the advisory's repository for collaborating on a fix.
		@json("private_fork", omitempty = true)
		privateFork ?RepositoryAdvisoryPrivateFork
	}

