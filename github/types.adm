	// A Dependabot alert.
	struct DependabotAlert {
		// The security alert number.
		@json(omitempty = true)
		number int = 0
		// The state of the Dependabot alert.
		@json(omitempty = true)
		state string = ""
		// Details for the vulnerable dependency.
		@json(omitempty = true)
		dependency DependabotAlertDependency = DependabotAlertDependency{}
		// Details for the GitHub Security Advisory.
		@json("security_advisory", omitempty = true)
		securityAdvisory DependabotAlertSecurityAdvisory = DependabotAlertSecurityAdvisory{}
		// Details pertaining to one vulnerable version range for the advisory.
		@json("security_vulnerability", omitempty = true)
		securityVulnerability DependabotAlertSecurityVulnerability = DependabotAlertSecurityVulnerability{}
		// The REST API URL of the alert resource.
		@json(omitempty = true)
		url string = ""
		// The GitHub URL of the alert resource.
		@json("html_url", omitempty = true)
		htmlUrl string = ""
		// The time that the alert was created in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
		@json("created_at", omitempty = true)
		createdAt time.Time = time.Time{}
		// The time that the alert was last updated in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
		@json("updated_at", omitempty = true)
		updatedAt time.Time = time.Time{}
		// The time that the alert was dismissed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
		@json("dismissed_at", omitempty = true)
		dismissedAt ?time.Time
		@json("dismissed_by", omitempty = true)
		dismissedBy ?SimpleUser
		// The reason that the alert was dismissed.
		@json("dismissed_reason", omitempty = true)
		dismissedReason ?string
		// An optional comment associated with the alert's dismissal.
		@json("dismissed_comment", omitempty = true)
		dismissedComment ?string
		// The time that the alert was no longer detected and was considered fixed in ISO 8601
		// format: `YYYY-MM-DDTHH:MM:SSZ`.
		@json("fixed_at", omitempty = true)
		fixedAt ?time.Time
		// The time that the alert was auto-dismissed in ISO 8601 format: `YYYY-MM-DDTHH:MM:SSZ`.
		@json("auto_dismissed_at", omitempty = true)
		autoDismissedAt ?time.Time
		// Information about an active dismissal request for this Dependabot alert.
		@json("dismissal_request", omitempty = true)
		dismissalRequest ?DependabotAlertDismissalRequestSimple
		// The users assigned to this alert.
		@json(omitempty = true)
		assignees SimpleUser[] = []
	}

	// Details for the vulnerable dependency.
	struct DependabotAlertDependency {
		// Details for the vulnerable package.
		@json(omitempty = true)
		package ?DependabotAlertPackage
		// The full path to the dependency manifest file, relative to the root of the repository.
		@json("manifest_path", omitempty = true)
		manifestPath string = ""
		// The dependency version or version constraint last recorded for the dependency associated
		// with this alert.
		@json("version_requirement", omitempty = true)
		versionRequirement ?string
		// The execution scope of the vulnerable dependency.
		@json(omitempty = true)
		scope ?string
		// The vulnerable dependency's relationship to your project.
		@json(omitempty = true)
		relationship ?string
	}

	// Information about an active dismissal request for this Dependabot alert.
	struct DependabotAlertDismissalRequestSimple {
		// The unique identifier of the dismissal request.
		@json(omitempty = true)
		id int = 0
		// The current status of the dismissal request.
		@json(omitempty = true)
		status string = ""
		// The user who requested the dismissal.
