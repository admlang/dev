	// Information of a job execution in a workflow run
	struct Job {
		// The id of the job.
		@json(omitempty = true)
		id int = 0
		// The id of the associated workflow run.
		@json("run_id", omitempty = true)
		runId int = 0
		@json("run_url", omitempty = true)
		runUrl string = ""
		// Attempt number of the associated workflow run, 1 for first attempt and higher if the
		// workflow was re-run.
		@json("run_attempt", omitempty = true)
		runAttempt int = 0
		@json("node_id", omitempty = true)
		nodeId string = ""
		// The SHA of the commit that is being run.
		@json("head_sha", omitempty = true)
		headSha string = ""
		@json(omitempty = true)
		url string = ""
		@json("html_url", omitempty = true)
		htmlUrl ?string
		// The phase of the lifecycle that the job is currently in.
		@json(omitempty = true)
		status string = ""
		// The outcome of the job.
		@json(omitempty = true)
		conclusion ?string
		// The time that the job created, in ISO 8601 format.
		@json("created_at", omitempty = true)
		createdAt time.Time = time.Time{}
		// The time that the job started, in ISO 8601 format.
		@json("started_at", omitempty = true)
		startedAt time.Time = time.Time{}
		// The time that the job finished, in ISO 8601 format.
		@json("completed_at", omitempty = true)
		completedAt ?time.Time
		// The name of the job.
		@json(omitempty = true)
		name string = ""
		// Steps in this job.
		@json(omitempty = true)
		steps JobStepsItem[] = []
		@json("check_run_url", omitempty = true)
		checkRunUrl string = ""
		// Labels for the workflow job.
		@json(omitempty = true)
		labels string[] = []
		// The ID of the runner to which this job has been assigned.
		@json("runner_id", omitempty = true)
		runnerId ?int
		// The name of the runner to which this job has been assigned.
		@json("runner_name", omitempty = true)
		runnerName ?string
		// The ID of the runner group to which this job has been assigned.
		@json("runner_group_id", omitempty = true)
		runnerGroupId ?int
		// The name of the runner group to which this job has been assigned.
		@json("runner_group_name", omitempty = true)
		runnerGroupName ?string
		// The name of the workflow.
		@json("workflow_name", omitempty = true)
		workflowName ?string
		// The name of the current branch.
		@json("head_branch", omitempty = true)
		headBranch ?string
	}

