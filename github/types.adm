		ignoreApprovalsFromContributors bool = false
		@json("linear_history_requirement_enforcement_level", omitempty = true)
		linearHistoryRequirementEnforcementLevel string = ""
		// The enforcement level of the branch lock setting.
		@json("lock_branch_enforcement_level", omitempty = true)
		lockBranchEnforcementLevel string = ""
		// Whether users can pull changes from upstream when the branch is locked.
		@json("lock_allows_fork_sync", omitempty = true)
