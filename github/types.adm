		pullRequestReviewsEnforcementLevel string = ""
		@json("repository_id", omitempty = true)
		repositoryId int = 0
		@json("require_code_owner_review", omitempty = true)
		requireCodeOwnerReview bool = false
		// Whether the most recent push must be approved by someone other than the person who
		// pushed it
		@json("require_last_push_approval", omitempty = true)
