		@json("repository_hooks", omitempty = true)
		repositoryHooks string = ""
		// The level of permission to grant the access token to manage repository projects,
		// columns, and cards.
		@json("repository_projects", omitempty = true)
		repositoryProjects string = ""
		// The level of permission to grant the access token to view and manage secret scanning
		// alerts.
		@json("secret_scanning_alerts", omitempty = true)
