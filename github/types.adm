		@json("required_status_checks_enforcement_level", omitempty = true)
		requiredStatusChecksEnforcementLevel string = ""
		@json("signature_requirement_enforcement_level", omitempty = true)
		signatureRequirementEnforcementLevel string = ""
		@json("strict_required_status_checks_policy", omitempty = true)
		strictRequiredStatusChecksPolicy bool = false
		@json("updated_at", omitempty = true)
		updatedAt time.Time = time.Time{}
	}

