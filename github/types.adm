	// Issues are a great way to keep track of tasks, enhancements, and bugs for your projects.
	partial type Issue {
		@json(omitempty = true)
		id int = 0
		@json("node_id", omitempty = true)
		nodeId string = ""
		// URL for the issue
		@json(omitempty = true)
		url string = ""
		@json("repository_url", omitempty = true)
		repositoryUrl string = ""
		@json("labels_url", omitempty = true)
		labelsUrl string = ""
		@json("comments_url", omitempty = true)
		commentsUrl string = ""
		@json("events_url", omitempty = true)
		eventsUrl string = ""
		@json("html_url", omitempty = true)
		htmlUrl string = ""
		// Number uniquely identifying the issue within its repository
		@json(omitempty = true)
		number int = 0
		// State of the issue; either 'open' or 'closed'
		@json(omitempty = true)
		state string = ""
		// The reason for the current state
		@json("state_reason", omitempty = true)
		stateReason ?string
		// Title of the issue
		@json(omitempty = true)
		title string = ""
		// Contents of the issue
		@json(omitempty = true)
		body ?string
		@json(omitempty = true)
		user ?SimpleUser
		// Labels to associate with this issue; pass one or more label names to replace the set of
		// labels on this issue; send an empty array to clear all labels from the issue; note that
		// the labels are silently dropped for users without push access to the repository
		@json(omitempty = true)
		labels any[] = []
		@json(omitempty = true)
		assignee ?SimpleUser
		@json(omitempty = true)
		assignees SimpleUser[] = []
		@json(omitempty = true)
		milestone ?Milestone
		@json(omitempty = true)
		locked bool = false
		@json("active_lock_reason", omitempty = true)
		activeLockReason ?string
		@json(omitempty = true)
		comments int = 0
		@json("pull_request", omitempty = true)
		pullRequest ?IssuePullRequest
		@json("closed_at", omitempty = true)
		closedAt ?time.Time
		@json("created_at", omitempty = true)
		createdAt time.Time = time.Time{}
		@json("updated_at", omitempty = true)
		updatedAt time.Time = time.Time{}
		@json(omitempty = true)
		draft bool = false
		@json("closed_by", omitempty = true)
		closedBy ?SimpleUser
		@json("body_html", omitempty = true)
		bodyHtml string = ""
		@json("body_text", omitempty = true)
		bodyText string = ""
		@json("timeline_url", omitempty = true)
		timelineUrl string = ""
		// The type assigned to the issue.
		@json("type", omitempty = true)
		typeName ?IssueType
		// A repository on GitHub.
		@json(omitempty = true)
		repository ?Repository
		@json("performed_via_github_app", omitempty = true)
		performedViaGithubApp ?Integration
		// How the author is associated with the repository.
		@json("author_association", omitempty = true)
		authorAssociation string = ""
		@json(omitempty = true)
		reactions ?ReactionRollup
		@json("sub_issues_summary", omitempty = true)
		subIssuesSummary ?SubIssuesSummary
		// URL to get the parent issue of this issue, if it is a sub-issue
		@json("parent_issue_url", omitempty = true)
		parentIssueUrl ?string
		@json("pinned_comment", omitempty = true)
		pinnedComment ?IssueComment
		@json("issue_dependencies_summary", omitempty = true)
		issueDependenciesSummary ?IssueDependenciesSummary
		@json("issue_field_values", omitempty = true)
		issueFieldValues IssueFieldValue[] = []
		// The repository the object came from, which its own methods
		// call the API about.
		@json(ignore = true)
		internal origin ?RepoRef = none
	}

