// Tests that need no GitHub: a loopback server that answers as the API
// does, an app key made for the tests, and webhook deliveries signed
// here.
partial module adm.dev.github {
	use (
		std.bytes
		std.crypto.hash::(Hash, hmac)
		std.data.encoding::(hexencode)
		std.net.http
		std.net.http.httptest
		std.proto.auth.jose
		std.testing
		std.time
		adm.dev.github.api::*
	)

	// An answer the loopback server gives a method and path.
	internal struct FakeAnswer {
		status  int
		body    string
		headers map<string, string> = {}
	}

	// A loopback server that answers as GitHub does: the answers given for
	// a method and path in turn (the last one again), else `body`.
	internal type FakeGitHub {
		// What an unanswered request gets: 200 with it, 204 when "".
		body             string                    = "{}"
		seen             string[]                  = []
		paths            string[]                  = []
		bodies           string[]                  = []
		headers          map<string, string>[]     = []
		internal answers map<string, FakeAnswer[]> = {}

		def new() {}

		def answer(key string, status int, body string, headers map<string, string> = {}) {
			let list = answers.get(key)
			if list is none {
				answers[key] = [FakeAnswer{status: status, body: body, headers: headers}]
				return
			}
			list.push(FakeAnswer{status: status, body: body, headers: headers})
		}

		def handle(ctx http.Context) !none {
			let path = ctx.path()
			let query = ctx.request.url.rawQuery
			let method = ctx.method().value
			seen.push("{method} {path}{query == "" ?? ("", "?" + query)}")
			paths.push("{method} {path}")
			bodies.push(try ctx.text())
			let picked map<string, string> = {}
			for let name in ["Authorization", "X-GitHub-Api-Version", "If-None-Match", "Content-Type", "Accept", "User-Agent"] {
				picked[name] = ctx.header(name) unless ctx.header(name) == ""
			}
			headers.push(picked)
			let list = answers.get("{method} {path}")
			if list is none {
				return ctx.noContent() when body == ""
				ctx.setHeader("Content-Type", "application/json")
				return ctx.text(200, body)
			}
			let next = list[0]
			list.remove(0) when list.len() > 1
			for let (name, value) in next.headers {
				ctx.setHeader(name, value)
			}
			ctx.setHeader("Content-Type", "application/json")
			return ctx.noContent(next.status) when next.status := 204 || 304
			return ctx.text(next.status, next.body)
		}

		// Whether the last request had the method and a path that matches
		// the pattern, `*` standing for one parameter.
		def last(method string, pattern string) bool {
			return false when paths.len() == 0
			let (verb, path) = splitRequest(paths[paths.len() - 1])
			return false unless verb == method
			let got = path.split("/")
			let want = pattern.split("/")
			return false unless got.len() == want.len() || pattern.endsWith("*")
			for let (at, part) in want {
				return true when at == want.len() - 1 && part == "*" && got.len() >= want.len()
				return false when at >= got.len()
				continue when part == "*"
				return false unless part == got[at]
			}
			return got.len() == want.len()
		}
	}

	internal def splitRequest(line string) (string, string) {
		let space = line.indexOf(" ")
		return (line.slice(0, space), line.slice(space + 1))
	}

	internal def fakeGitHub(fake FakeGitHub) !httptest.Server {
		let mux = new http.ServeMux()
		try mux.handle("/", def (ctx http.Context) !none {
			return try fake.handle(ctx)
		})
		return try httptest.Server.start(mux)
	}

	// A Client whose API, uploads and GraphQL are the loopback server.
	internal def fakeClient(server httptest.Server, auth ?Authenticator = none) !Client {
		let root = "http://{server.address().str()}"
		let credentials Authenticator = auth is none ?? (new TokenAuth(new Secret<string>("test-token")), auth)
		return new Client(new Link(root, "{root}/uploads", "{root}/graphql", credentials))
	}

	internal def kindOf(err error) ErrorKind {
		return err.kind when err is GitHubError
		return ErrorKind.Server
	}

