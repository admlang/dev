// The parameters of a request: those of its query string, or the members
// of its body (JSON, or a multipart form when it carries a file), each
// left out when the caller gave none.
internal partial module adm.dev.gitlab.api {
	use (
		std.bytes
		std.data.encoding::(JSON)
		std.net.multipart
		std.net.url
		std.time
		adm.dev.gitlab::*
	)

	// A file a request uploads.
	struct UploadFile {
		data byte[]
		name string
	}

	// Params are a request's parameters, in the order they were put.
	type Params {
		internal values map<string, any>        = {}
		internal files  map<string, UploadFile> = {}

		def new() {}

		def put(name string, value string) {
			values[name] = value
		}

		def put(name string, value ?string) {
			values[name] = value unless value is none
		}

		def put(name string, value int) {
			values[name] = value
		}

		def put(name string, value ?int) {
			values[name] = value unless value is none
		}

		def put(name string, value float) {
			values[name] = value
		}

		def put(name string, value ?float) {
			values[name] = value unless value is none
		}

		def put(name string, value bool) {
			values[name] = value
		}

		def put(name string, value ?bool) {
			values[name] = value unless value is none
		}

		def put(name string, value time.Time) {
			values[name] = value.str()
		}

		def put(name string, value ?time.Time) {
			values[name] = value.str() unless value is none
		}

		def put(name string, value State) {
			values[name] = value.value
		}

		def put(name string, value ?State) {
			values[name] = value.value unless value is none
		}

		def put(name string, value string[]) {
			values[name] = value unless value.len() == 0
		}

		def put(name string, value int[]) {
			values[name] = value unless value.len() == 0
		}

		def put(name string, value any) {
			values[name] = value unless value is none
		}

		// Variables of a pipeline, a trigger or a schedule: the map as the
		// `[{key, value}]` GitLab takes.
		def putVariables(name string, value map<string, string>) {
			return when value.len() == 0
			let list any[] = []
			for let (key, text) in value {
				list.push(map<string, any>{"key": key, "value": text})
			}
			values[name] = list
		}

		// A file the request uploads, as a multipart form.
		def putFile(name string, data byte[], fileName string) {
			files[name] = UploadFile{data: data, name: fileName}
		}

		def len() int {
			return values.len() + files.len()
		}

		// Whether a parameter was put.
		def has(name string) bool {
			return values.hasKey(name)
		}

		// A copy, to add to without changing these.
		def clone() Params {
			let out = new Params()
			out.values = values.clone()
			out.files = files.clone()
			return out
		}

		// The parameters as a query string, sorted by name; a list as
		// `name[]=` once per value.
		def encode() string {
			let query = new url.Values()
			for let (name, value) in values {
				if value is any[] {
					for let item in value {
						query.add("{name}[]", textOf(item))
					}
				} else if value is string[] {
					for let item in value {
						query.add("{name}[]", item)
					}
				} else if value is int[] {
					for let item in value {
						query.add("{name}[]", "{item}")
					}
				} else {
					query.set(name, textOf(value))
				}
			}
			return query.encode()
		}

		// The body and its content type: JSON, or a multipart form when a
		// file is among the parameters.
		// Fails when the form cannot be written.
		def body() !(byte[], string) {
			return (new JSON().encode(values), "application/json") when files.len() == 0
			let sink = new bytes.Buffer()
			let form = new multipart.Writer(sink)
			for let (name, value) in values {
				try form.writeField(name, textOf(value))
			}
			for let (name, file) in files {
				let part = try form.createFormFile(name, file.name)
				try part.write(file.data)
			}
			try form.close()
			return (sink.bytes(), form.formDataContentType())
		}
	}

	// A parameter as text.
	def textOf(value any) string {
		return value when value is string
		return value ?? ("true", "false") when value is bool
		return "{value}"
	}

	// A path parameter: escaped whole, slashes too (`group%2Fproject`,
	// a file's path), as GitLab takes it.
	def segment(value string) string {
		return url.pathEscape(value).replace("/", "%2F")
	}

	def segment(value int) string {
		return "{value}"
	}

	def segment(value any) string {
		return value is string ?? (segment(value), "{value}")
	}

	// An answer that is an object of any members, read as JSON.
	// Fails with ErrorKind.Protocol when it is not a JSON object.
	def parseObject(data byte[]) !map<string, any> {
		let parsed = try parseValue(data)
		fail errorOf(ErrorKind.Protocol, "gitlab: the answer is not a JSON object") unless parsed is map<string, any>
		return parsed
	}

	// An answer that is not an object, read as JSON; its text when it is
	// not JSON (a raw file, a diff); none when there is none.
	def parseValue(data byte[]) !any {
		return none when data.len() == 0
		let parsed = new JSON().parse(data) onerror recover string(data)
		return parsed
	}
}
