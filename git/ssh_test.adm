// SSH remotes against an in-process SSH server running the services;
// credential helpers; submodules.
partial module adm.dev.git {
	use (
		std.os
		std.testing
		std.net.ssh
	)

	// An SSH server on a loopback port that runs `git-upload-pack` and
	// `git-receive-pack` commands with this library's server.
	internal def gitSshServer() !ssh.Server {
		let server = new ssh.Server(new ssh.HandlerFunc(def (s ssh.Session) !none {
			return try serveGitSession(s)
		}), "127.0.0.1:0")
		server.hostKeys.push(try ssh.generateKey())
		try server.start()
		return server
	}

	// Serves the session's command: `<program> '<path>'`.
	internal def serveGitSession(s ssh.Session) !none {
		let command = s.command()
		let space = command.indexOf(" ")
		fail "not a git command: {command}" when space < 0
		let program = command.slice(0, space)
		let quoted = command.slice(space + 1)
		fail "path not quoted: {quoted}" unless quoted.startsWith("'") && quoted.endsWith("'")
		let path = quoted.slice(1, quoted.len() - 1).replace("'\\''", "'")
		let env = s.environment()
		let protocol = env.get("GIT_PROTOCOL")
		let version = !(protocol is none) && protocol.contains("version=2") ?? (2, 0)
		let repo = try open(path)
		let failure ?error = none
		serveStateful(repo, program, version, new PktReader(s), s) onerror (err error) {
			failure = err
			recover none
		}
		repo.close()
		try s.exit(failure is none ?? (0, 1))
		return none
	}

	// A client that trusts any host key and logs in with a fresh key, never
	// the user's own.
	internal def testSshClient() !ssh.Client {
		let client = new ssh.Client()
		client.hostKeyPolicy = ssh.HostKeyPolicy.Insecure
		client.useAgent = false
		client.keys.push(try ssh.generateKey())
		return client
	}

	check "SSH, credentials and submodules" {
		@test()
		def clonesAndPushesOverSsh() !none {
			let (src, ids) = try servedRepo("ssh-src")
			let server = try gitSshServer()
			let url = "ssh://git@{server.address().str()}{src.gitDir}"
			let branch = try src.branch()
			for let v in protocols {
				let dir = try scratch("ssh-clone-v{v}")
				let repo = try clone(url, dir, connection = RemoteOptions{protocol: v, ssh: try testSshClient()})
				fail "v{v}: HEAD not at the tip" unless (try repo.resolve("HEAD")).equals(ids[1])
				let next = try addCommit(repo, branch, ids[1], "Over SSH v{v}")
				let pushed = try repo.push("origin", connection = RemoteOptions{protocol: v, ssh: try testSshClient()})
				fail "v{v}: not pushed: {pushed.changes[0].reason}" unless pushed.changes[0].kind == RefChangeKind.FastForward
				fail "v{v}: server not moved" unless (try src.resolve(branch)).equals(next)
				try src.setRef("refs/heads/{branch}", ids[1])
				let fetched = try repo.fetch("origin", connection = RemoteOptions{protocol: v, ssh: try testSshClient()}, force = true)
				fail "v{v}: rewind not fetched" unless fetched.changes.filter(c => c.kind == RefChangeKind.Forced).len() == 1
				repo.close()
			}
			try server.close()
			return none
		}

		@test()
		def usesCredentialHelpers() !none {
			let (src, ids) = try servedRepo("helper-src")
			let ts = try gitHttpServer(src.gitDir)
			let url = ts.url + "/repo.git"
			let repo = try clone(url, try scratch("helper-clone"))
			let branch = try repo.branch()
			let store = os.join(repo.gitDir, "test-credentials")
			try repo.config.set("credential.helper", "store --file={store}")
			// Asked once, then kept by the store helper.
			let asked = 0
			let ask = def (req CredentialRequest) !?Credentials {
				asked++
				return Credentials{username: "ana", password: new Secret<string>("secret")}
			}
			let first = try addCommit(repo, branch, ids[1], "First with a helper")
			let pushed = try repo.push("origin", connection = RemoteOptions{ask: ask})
			fail "not pushed: {pushed.changes[0].reason}" unless pushed.changes[0].kind == RefChangeKind.FastForward
			let stored = string(try os.readFile(store))
			fail "store holds {stored}" unless stored.contains("ana:secret@127.0.0.1")
			let second = try addCommit(repo, branch, first, "Second with a helper")
			let again = try repo.push("origin", connection = RemoteOptions{ask: ask})
			fail "second push failed: {again.changes[0].reason}" unless again.changes[0].kind == RefChangeKind.FastForward
			fail "asked {asked} times" unless asked == 1
			// A wrong stored password is erased, and the program asked again.
			try os.writeFile(store, stored.replace("secret", "stale").bytes())
			let third = try addCommit(repo, branch, second, "Third with a helper")
			let _ = third
			let retried = try repo.push("origin", connection = RemoteOptions{ask: ask})
			fail "retry failed: {retried.changes[0].reason}" unless retried.changes[0].kind == RefChangeKind.FastForward
			fail "asked {asked} times after a refusal" unless asked == 2
			fail "stale login kept" when string(try os.readFile(store)).contains("stale")
			// A shell helper.
			try repo.config.set("credential.helper", "!f() \{ echo username=ana; echo password=secret; \}; f")
			let fourth = try addCommit(repo, branch, try repo.resolve("HEAD"), "Fourth with a shell helper")
			let _ = fourth
			let shell = try repo.push("origin", connection = RemoteOptions{})
			fail "shell helper push failed: {shell.changes[0].reason}" unless shell.changes[0].kind == RefChangeKind.FastForward
			repo.close()
			try ts.close()
			return none
		}

		// A `.gitmodules` name that would leave `.git/modules` is refused, and
		// so is a submodule path that goes through a symbolic link: neither
		// writes anything outside the superproject.
		@test()
		def refusesEscapingSubmodules() !none {
			let (sub, subIds) = try servedRepo("submodule-escape-lib")
			let make = def (name string) !string {
				let superDir = try scratch("submodule-escape-{name.len()}")
				let sup = try init(superDir, InitOptions{bare: true})
				let modules = try sup.writeBlob("[submodule \"{name}\"]\n\tpath = sub\n\turl = {sub.gitDir}\n".bytes())
				let root = try sup.writeTree([
					TreeEntry{name: ".gitmodules", mode: EntryMode.File, id: modules},
					TreeEntry{name: "sub", mode: EntryMode.Submodule, id: subIds[1]},
				])
				let sig = testSignature()
				let c = try sup.write(ObjectKind.Commit, (new Commit(zeroId(sup.format), root, [], sig, sig, "Add sub\n")).encode())
				try sup.setRef("refs/heads/{try sup.branch()}", c)
				sup.close()
				return superDir
			}
			let escaping = try make("../../../escaped")
			let dir = try scratch("submodule-escape-clone")
			let repo = try clone(escaping, dir)
			let refused = ""
			repo.updateSubmodules(SubmoduleOptions{init: true}) onerror (err error) {
				refused = err.message
				recover none
			}
			fail "bad name taken: {refused}" unless refused.contains("submodule name") && refused.contains("not allowed")
			fail "repository written outside" when os.exists(os.join(dir, "..", "..", "escaped")) onerror recover false
			fail "modules folder made" when os.exists(os.join(dir, ".git", "modules")) onerror recover false
			repo.close()
			// A plain name, but the path is a link to a folder elsewhere.
			let plain = try make("lib")
			let dir2 = try scratch("submodule-link-clone")
			let repo2 = try clone(plain, dir2)
			let elsewhere = try scratch("submodule-link-target")
			// The checkout left an empty folder for the gitlink; a link takes its place.
			os.remove(os.join(dir2, "sub"), true) onerror recover none
			try os.symlink(elsewhere, os.join(dir2, "sub"))
			refused = ""
			repo2.updateSubmodules(SubmoduleOptions{init: true}) onerror (err error) {
				refused = err.message
				recover none
			}
			fail "link taken: {refused}" unless refused.contains("goes through a link")
			fail "written through the link" unless (try os.readDirNames(elsewhere)).len() == 0
			repo2.close()
			return none
		}

		// A submodule is added, inspected, opened, retargeted, updated with
		// progress and removed, `.gitmodules`, the index and the configuration
		// following.
		@test()
		def managesSubmodules() !none {
			let (sub, subIds) = try servedRepo("submodule-managed-lib")
			let repo = try newWorktree("submodule-manager")
			try writeFile(repo, "README.md", "top\n")
			try repo.add(".")
			let _ = try repo.commit("Start")
			let added = try repo.addSubmodule(sub.gitDir, "vendor/lib")
			fail "added: {added.name} {added.path} cloned {added.cloned} init {added.initialized}" unless added.name == "vendor/lib" && added.path == "vendor/lib" && added.cloned && added.initialized
			let head = added.head
			fail "head" unless !(head is none) && head.equals(subIds[1])
			let staged = added.commit
			fail "gitlink staged" unless !(staged is none) && staged.equals(subIds[1])
			let modules = string(try os.readFile(os.join(repo.workDir, ".gitmodules")))
			fail "gitmodules: {modules}" unless modules.contains("[submodule \"vendor/lib\"]") && modules.contains("path = vendor/lib") && modules.contains("url = {sub.gitDir}")
			fail "config" unless repo.config.get("submodule.vendor/lib.url", "") == sub.gitDir
			let st = try repo.status()
			fail "status: {st.entries.len()}" unless st.entries.len() == 2
			let _ = try repo.commit("Add lib")
			let inner = try repo.openSubmodule("vendor/lib")
			fail "opened" unless (try inner.resolve("HEAD")).equals(subIds[1])
			inner.close()
			try repo.setSubmoduleBranch("vendor/lib", "main")
			fail "branch" unless string(try os.readFile(os.join(repo.workDir, ".gitmodules"))).contains("branch = main")
			try repo.setSubmoduleBranch("vendor/lib", "")
			fail "branch kept" when string(try os.readFile(os.join(repo.workDir, ".gitmodules"))).contains("branch =")
			let other = try scratch("submodule-other-url")
			try repo.setSubmoduleUrl("vendor/lib", other)
			fail "url" unless repo.config.get("submodule.vendor/lib.url", "") == other
			let synced = try repo.openSubmodule("vendor/lib")
			fail "origin" unless synced.config.get("remote.origin.url", "") == other
			synced.close()
			try repo.setSubmoduleUrl("vendor/lib", sub.gitDir)
			// Updating reports its steps; told to stop, it stops.
			let phases string[] = []
			try repo.updateSubmodules(SubmoduleOptions{progress: def (p Progress) bool {
				phases.push("{p.phase} {p.done}/{p.total}")
				return true
			}})
			fail "phases: {phases.join(", ")}" unless phases.join(", ") == "fetching 0/1, checking out 0/1, checking out 1/1"
			let stopped = ""
			repo.updateSubmodules(SubmoduleOptions{progress: (p Progress) => false}) onerror (err error) {
				stopped = err.code
				recover none
			}
			fail "not stopped" unless stopped == "stopped"
			let listed = try repo.submodules()
			fail "listed {listed.len()}" unless listed.len() == 1 && !(listed[0].head is none)
			try repo.removeSubmodule("vendor/lib")
			fail "folder left" when os.exists(os.join(repo.workDir, "vendor", "lib")) onerror recover false
			fail "modules left" when os.exists(os.join(repo.gitDir, "modules", "vendor", "lib")) onerror recover false
			fail "config left" unless repo.config.get("submodule.vendor/lib.url") is none
			fail "gitmodules left: {string(try os.readFile(os.join(repo.workDir, ".gitmodules")))}" when string(try os.readFile(os.join(repo.workDir, ".gitmodules"))).contains("vendor/lib")
			fail "still listed" unless (try repo.submodules()).len() == 0
			let idx = try repo.index()
			fail "index entry left" unless idx.entry("vendor/lib") is none
			repo.close()
			return none
		}

		@test()
		def clonesSubmodules() !none {
			let (sub, subIds) = try servedRepo("submodule-lib")
			let superDir = try scratch("submodule-super")
			let sup = try init(superDir, InitOptions{bare: true})
			let modules = try sup.writeBlob("[submodule \"lib\"]\n\tpath = vendor/lib\n\turl = {sub.gitDir}\n".bytes())
			let vendor = try sup.writeTree([TreeEntry{name: "lib", mode: EntryMode.Submodule, id: subIds[1]}])
			let root = try sup.writeTree([
				TreeEntry{name: ".gitmodules", mode: EntryMode.File, id: modules},
				TreeEntry{name: "vendor", mode: EntryMode.Tree, id: vendor},
			])
			let sig = testSignature()
			let c = try sup.write(ObjectKind.Commit, (new Commit(zeroId(sup.format), root, [], sig, sig, "Add lib\n")).encode())
			try sup.setRef("refs/heads/{try sup.branch()}", c)
			let dir = try scratch("submodule-clone")
			let repo = try clone(sup.gitDir, dir, submodules = true)
			let mods = try repo.submodules()
			fail "{mods.len()} submodules" unless mods.len() == 1 && mods[0].path == "vendor/lib" && mods[0].cloned && mods[0].initialized
			let recorded = mods[0].commit
			fail "submodule commit not recorded" when recorded is none
			fail "submodule commit {recorded.str()}" unless recorded.equals(subIds[1])
			let readme = string(try os.readFile(os.join(dir, "vendor", "lib", "README.md")))
			fail "submodule README reads {readme}" unless readme == "# Notes\n\nMore.\n"
			let inner = try open(os.join(dir, "vendor", "lib"))
			fail "submodule HEAD not detached at the commit" unless (try inner.headRef()) == "" && (try inner.resolve("HEAD")).equals(subIds[1])
			inner.close()
			let st = try repo.status()
			fail "superproject not clean: {st.entries.len()}" unless st.entries.len() == 0
			repo.close()
			return none
		}
	}
}
